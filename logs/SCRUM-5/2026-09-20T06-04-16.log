{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QPASAunHXe5KFoQFvddYPs","type":"tool_result","content":"1\t// Package ghissues implements tracker.Tracker over GitHub Issues.\n2\t//\n3\t// GitHub has no workflow states and no custom fields, so state is carried\n4\t// by one hive:* label at a time and the claim by a hidden HTML comment at\n5\t// the end of the issue body. Ticket keys are \"<PROJECT>-<number>\", where\n6\t// PROJECT is the repo's configured project key, so the rest of HiveDispatch\n7\t// sees the same key shape as with Jira.\n8\tpackage ghissues\n9\t\n10\timport (\n11\t\t\"bytes\"\n12\t\t\"context\"\n13\t\t\"encoding/json\"\n14\t\t\"fmt\"\n15\t\t\"io\"\n16\t\t\"net/http\"\n17\t\t\"net/url\"\n18\t\t\"strconv\"\n19\t\t\"strings\"\n20\t\t\"time\"\n21\t\n22\t\t\"github.com/thomasmeadows/hivedispatch/internal/config\"\n23\t\t\"github.com/thomasmeadows/hivedispatch/internal/tracker\"\n24\t)\n25\t\n26\t// Client is a GitHub Issues tracker over one or more repositories.\n27\ttype Client struct {\n28\t\tcfg   config.GitHubConfig\n29\t\trepos []config.RepoConfig\n30\t\tapi   *url.URL\n31\t\thttp  *http.Client\n32\t\tnow   func() time.Time\n33\t\n34\t\tbeforeReadBack func(key string)\n35\t}\n36\t\n37\tvar _ tracker.Tracker = (*Client)(nil)\n38\t\n39\t// Option configures a Client.\n40\ttype Option func(*Client)\n41\t\n42\t// WithHTTPClient replaces the default HTTP client.\n43\tfunc WithHTTPClient(h *http.Client) Option {\n44\t\treturn func(c *Client) { c.http = h }\n45\t}\n46\t\n47\tfunc withNow(f func() time.Time) Option {\n48\t\treturn func(c *Client) { c.now = f }\n49\t}\n50\t\n51\tfunc withBeforeReadBack(f func(key string)) Option {\n52\t\treturn func(c *Client) { c.beforeReadBack = f }\n53\t}\n54\t\n55\t// New returns a Client for the repositories in repos.\n56\tfunc New(cfg config.GitHubConfig, repos []config.RepoConfig, opts ...Option) (*Client, error) {\n57\t\tapi, err := url.Parse(strings.TrimRight(cfg.APIURL, \"/\"))\n58\t\tif err != nil || api.Scheme == \"\" || api.Host == \"\" {\n59\t\t\treturn nil, fmt.Errorf(\"ghissues: invalid api_url %q\", cfg.APIURL)\n60\t\t}\n61\t\tc := &Client{cfg: cfg, repos: repos, api: api, http: &http.Client{Timeout: 30 * time.Second}, now: time.Now}\n62\t\tfor _, o := range opts {\n63\t\t\to(c)\n64\t\t}\n65\t\treturn c, nil\n66\t}\n67\t\n68\t// keyToRef maps \"PROJECT-12\" to the repo it belongs to and the issue number.\n69\tfunc (c *Client) keyToRef(key string) (repo string, number int, err error) {\n70\t\tproject, num, ok := strings.Cut(key, \"-\")\n71\t\tif !ok {\n72\t\t\treturn \"\", 0, fmt.Errorf(\"ghissues: %q is not PROJECT-N\", key)\n73\t\t}\n74\t\tn, err := strconv.Atoi(num)\n75\t\tif err != nil || n <= 0 {\n76\t\t\treturn \"\", 0, fmt.Errorf(\"ghissues: %q is not PROJECT-N\", key)\n77\t\t}\n78\t\tfor _, r := range c.repos {\n79\t\t\tif strings.EqualFold(r.Project, project) {\n80\t\t\t\treturn r.Name, n, nil\n81\t\t\t}\n82\t\t}\n83\t\treturn \"\", 0, fmt.Errorf(\"ghissues: no repo configured with project %q\", project)\n84\t}\n85\t\n86\t// refToKey maps a repo and issue number back to a ticket key.\n87\tfunc (c *Client) refToKey(repo string, number int) (string, bool) {\n88\t\tfor _, r := range c.repos {\n89\t\t\tif strings.EqualFold(r.Name, repo) {\n90\t\t\t\treturn fmt.Sprintf(\"%s-%d\", strings.ToUpper(r.Project), number), true\n91\t\t\t}\n92\t\t}\n93\t\treturn \"\", false\n94\t}\n95\t\n96\t// APIError is a non-2xx response.\n97\ttype APIError struct {\n98\t\tStatus  int\n99\t\tMethod  string\n100\t\tPath    string\n101\t\tMessage string\n102\t}\n103\t\n104\tfunc (e *APIError) Error() string {\n105\t\treturn fmt.Sprintf(\"github: %s %s: %d: %s\", e.Method, e.Path, e.Status, e.Message)\n106\t}\n107\t\n108\t// Is lets a 404 satisfy errors.Is(err, tracker.ErrNotFound).\n109\tfunc (e *APIError) Is(target error) bool {\n110\t\treturn target == tracker.ErrNotFound && e.Status == http.StatusNotFound\n111\t}\n112\t\n113\t// do performs one JSON request against path (absolute URL or API path) and\n114\t// returns the response headers (for pagination).\n115\tfunc (c *Client) do(ctx context.Context, method, path string, body, out any) (http.Header, error) {\n116\t\tvar rdr io.Reader\n117\t\tif body != nil {\n118\t\t\traw, err := json.Marshal(body)\n119\t\t\tif err != nil {\n120\t\t\t\treturn nil, err\n121\t\t\t}\n122\t\t\trdr = bytes.NewReader(raw)\n123\t\t}\n124\t\tref, err := url.Parse(path)\n125\t\tif err != nil {\n126\t\t\treturn nil, fmt.Errorf(\"github: bad path %q: %w\", path, err)\n127\t\t}\n128\t\treq, err := http.NewRequestWithContext(ctx, method, c.api.ResolveReference(ref).String(), rdr)\n129\t\tif err != nil {\n130\t\t\treturn nil, err\n131\t\t}\n132\t\treq.Header.Set(\"Authorization\", \"Bearer \"+c.cfg.Token)\n133\t\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n134\t\treq.Header.Set(\"X-GitHub-Api-Version\", \"2022-11-28\")\n135\t\tif body != nil {\n136\t\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n137\t\t}\n138\t\tresp, err := c.http.Do(req)\n139\t\tif err != nil {\n140\t\t\treturn nil, fmt.Errorf(\"github: %s %s: %w\", method, path, err)\n141\t\t}\n142\t\tdefer func() { _ = resp.Body.Close() }()\n143\t\traw, err := io.ReadAll(io.LimitReader(resp.Body, 8<<20))\n144\t\tif err != nil {\n145\t\t\treturn nil, err\n146\t\t}\n147\t\tif resp.StatusCode < 200 || resp.StatusCode > 299 {\n148\t\t\tvar e struct {\n149\t\t\t\tMessage string `json:\"message\"`\n150\t\t\t}\n151\t\t\tmsg := strings.TrimSpace(string(raw))\n152\t\t\tif json.Unmarshal(raw, &e) == nil && e.Message != \"\" {\n153\t\t\t\tmsg = e.Message\n154\t\t\t}\n155\t\t\treturn resp.Header, &APIError{Status: resp.StatusCode, Method: method, Path: ref.Path, Message: msg}\n156\t\t}\n157\t\tif out != nil && len(bytes.TrimSpace(raw)) > 0 {\n158\t\t\tif err := json.Unmarshal(raw, out); err != nil {\n159\t\t\t\treturn resp.Header, fmt.Errorf(\"github: decode %s %s: %w\", method, path, err)\n160\t\t\t}\n161\t\t}\n162\t\treturn resp.Header, nil\n163\t}\n164\t\n165\t// nextLink extracts the rel=\"next\" URL from a Link header, or \"\".\n166\tfunc nextLink(h http.Header) string {\n167\t\tfor _, part := range strings.Split(h.Get(\"Link\"), \",\") {\n168\t\t\tpart = strings.TrimSpace(part)\n169\t\t\tif !strings.HasSuffix(part, `rel=\"next\"`) {\n170\t\t\t\tcontinue\n171\t\t\t}\n172\t\t\tstart, end := strings.Index(part, \"<\"), strings.Index(part, \">\")\n173\t\t\tif start >= 0 && end > start {\n174\t\t\t\treturn part[start+1 : end]\n175\t\t\t}\n176\t\t}\n177\t\treturn \"\"\n178\t}\n179\t\n180\tfunc issuePath(repo string, number int, suffix string) string {\n181\t\treturn fmt.Sprintf(\"/repos/%s/issues/%d%s\", repo, number, suffix)\n182\t}\n183\t\n184\tfunc jsonUnmarshal(raw []byte, v any) error { return json.Unmarshal(raw, v) }\n185\t"}]},"parent_tool_use_id":null,"session_id":"2daaed25-284e-4780-838f-5b169e1711d5","uuid":"93fbd967-cb23-4235-9141-9a72d627ed21","timestamp":"2026-09-20T05:57:07.226Z","tool_use_result":{"type":"text","file":{"filePath":"/home/thomas/.local/share/hivedispatch/repos/thomasmeadows__HiveDispatch/SCRUM-5/internal/tracker/ghissues/client.go","content":"// Package ghissues implements tracker.Tracker over GitHub Issues.\n//\n// GitHub has no workflow states and no custom fields, so state is carried\n// by one hive:* label at a time and the claim by a hidden HTML comment at\n// the end of the issue body. Ticket keys are \"<PROJECT>-<number>\", where\n// PROJECT is the repo's configured project key, so the rest of HiveDispatch\n// sees the same key shape as with Jira.\npackage ghissues\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/thomasmeadows/hivedispatch/internal/config\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/tracker\"\n)\n\n// Client is a GitHub Issues tracker over one or more repositories.\ntype Client struct {\n\tcfg   config.GitHubConfig\n\trepos []config.RepoConfig\n\tapi   *url.URL\n\thttp  *http.Client\n\tnow   func() time.Time\n\n\tbeforeReadBack func(key string)\n}\n\nvar _ tracker.Tracker = (*Client)(nil)\n\n// Option configures a Client.\ntype Option func(*Client)\n\n// WithHTTPClient replaces the default HTTP client.\nfunc WithHTTPClient(h *http.Client) Option {\n\treturn func(c *Client) { c.http = h }\n}\n\nfunc withNow(f func() time.Time) Option {\n\treturn func(c *Client) { c.now = f }\n}\n\nfunc withBeforeReadBack(f func(key string)) Option {\n\treturn func(c *Client) { c.beforeReadBack = f }\n}\n\n// New returns a Client for the repositories in repos.\nfunc New(cfg config.GitHubConfig, repos []config.RepoConfig, opts ...Option) (*Client, error) {\n\tapi, err := url.Parse(strings.TrimRight(cfg.APIURL, \"/\"))\n\tif err != nil || api.Scheme == \"\" || api.Host == \"\" {\n\t\treturn nil, fmt.Errorf(\"ghissues: invalid api_url %q\", cfg.APIURL)\n\t}\n\tc := &Client{cfg: cfg, repos: repos, api: api, http: &http.Client{Timeout: 30 * time.Second}, now: time.Now}\n\tfor _, o := range opts {\n\t\to(c)\n\t}\n\treturn c, nil\n}\n\n// keyToRef maps \"PROJECT-12\" to the repo it belongs to and the issue number.\nfunc (c *Client) keyToRef(key string) (repo string, number int, err error) {\n\tproject, num, ok := strings.Cut(key, \"-\")\n\tif !ok {\n\t\treturn \"\", 0, fmt.Errorf(\"ghissues: %q is not PROJECT-N\", key)\n\t}\n\tn, err := strconv.Atoi(num)\n\tif err != nil || n <= 0 {\n\t\treturn \"\", 0, fmt.Errorf(\"ghissues: %q is not PROJECT-N\", key)\n\t}\n\tfor _, r := range c.repos {\n\t\tif strings.EqualFold(r.Project, project) {\n\t\t\treturn r.Name, n, nil\n\t\t}\n\t}\n\treturn \"\", 0, fmt.Errorf(\"ghissues: no repo configured with project %q\", project)\n}\n\n// refToKey maps a repo and issue number back to a ticket key.\nfunc (c *Client) refToKey(repo string, number int) (string, bool) {\n\tfor _, r := range c.repos {\n\t\tif strings.EqualFold(r.Name, repo) {\n\t\t\treturn fmt.Sprintf(\"%s-%d\", strings.ToUpper(r.Project), number), true\n\t\t}\n\t}\n\treturn \"\", false\n}\n\n// APIError is a non-2xx response.\ntype APIError struct {\n\tStatus  int\n\tMethod  string\n\tPath    string\n\tMessage string\n}\n\nfunc (e *APIError) Error() string {\n\treturn fmt.Sprintf(\"github: %s %s: %d: %s\", e.Method, e.Path, e.Status, e.Message)\n}\n\n// Is lets a 404 satisfy errors.Is(err, tracker.ErrNotFound).\nfunc (e *APIError) Is(target error) bool {\n\treturn target == tracker.ErrNotFound && e.Status == http.StatusNotFound\n}\n\n// do performs one JSON request against path (absolute URL or API path) and\n// returns the response headers (for pagination).\nfunc (c *Client) do(ctx context.Context, method, path string, body, out any) (http.Header, error) {\n\tvar rdr io.Reader\n\tif body != nil {\n\t\traw, err := json.Marshal(body)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\trdr = bytes.NewReader(raw)\n\t}\n\tref, err := url.Parse(path)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"github: bad path %q: %w\", path, err)\n\t}\n\treq, err := http.NewRequestWithContext(ctx, method, c.api.ResolveReference(ref).String(), rdr)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treq.Header.Set(\"Authorization\", \"Bearer \"+c.cfg.Token)\n\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n\treq.Header.Set(\"X-GitHub-Api-Version\", \"2022-11-28\")\n\tif body != nil {\n\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n\t}\n\tresp, err := c.http.Do(req)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"github: %s %s: %w\", method, path, err)\n\t}\n\tdefer func() { _ = resp.Body.Close() }()\n\traw, err := io.ReadAll(io.LimitReader(resp.Body, 8<<20))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif resp.StatusCode < 200 || resp.StatusCode > 299 {\n\t\tvar e struct {\n\t\t\tMessage string `json:\"message\"`\n\t\t}\n\t\tmsg := strings.TrimSpace(string(raw))\n\t\tif json.Unmarshal(raw, &e) == nil && e.Message != \"\" {\n\t\t\tmsg = e.Message\n\t\t}\n\t\treturn resp.Header, &APIError{Status: resp.StatusCode, Method: method, Path: ref.Path, Message: msg}\n\t}\n\tif out != nil && len(bytes.TrimSpace(raw)) > 0 {\n\t\tif err := json.Unmarshal(raw, out); err != nil {\n\t\t\treturn resp.Header, fmt.Errorf(\"github: decode %s %s: %w\", method, path, err)\n\t\t}\n\t}\n\treturn resp.Header, nil\n}\n\n// nextLink extracts the rel=\"next\" URL from a Link header, or \"\".\nfunc nextLink(h http.Header) string {\n\tfor _, part := range strings.Split(h.Get(\"Link\"), \",\") {\n\t\tpart = strings.TrimSpace(part)\n\t\tif !strings.HasSuffix(part, `rel=\"next\"`) {\n\t\t\tcontinue\n\t\t}\n\t\tstart, end := strings.Index(part, \"<\"), strings.Index(part, \">\")\n\t\tif start >= 0 && end > start {\n\t\t\treturn part[start+1 : end]\n\t\t}\n\t}\n\treturn \"\"\n}\n\nfunc issuePath(repo string, number int, suffix string) string {\n\treturn fmt.Sprintf(\"/repos/%s/issues/%d%s\", repo, number, suffix)\n}\n\nfunc jsonUnmarshal(raw []byte, v any) error { return json.Unmarshal(raw, v) }\n","numLines":185,"startLine":1,"totalLines":185}}}
