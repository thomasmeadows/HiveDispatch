{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NiTRr4wNy7mZvyB9uiQwot","type":"tool_result","content":"1\tpackage ghissues\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"net/http\"\n8\t\t\"strings\"\n9\t\t\"testing\"\n10\t\t\"time\"\n11\t\n12\t\t\"github.com/thomasmeadows/hivedispatch/internal/tracker\"\n13\t)\n14\t\n15\tconst issueFixture = `{\n16\t  \"number\": 12, \"title\": \"Add --version\", \"state\": \"open\",\n17\t  \"html_url\": \"https://github.com/o/r/issues/12\",\n18\t  \"body\": \"Print the version.\\n\\n<!-- hivedispatch-claim: worker-b 2026-09-20T10:00:00Z -->\",\n19\t  \"labels\": [{\"name\": \"hive:ready\"}, {\"name\": \"bug\"}],\n20\t  \"updated_at\": \"2026-09-20T10:15:00Z\"\n21\t}`\n22\t\n23\tfunc TestGetMapsIssue(t *testing.T) {\n24\t\tmux := http.NewServeMux()\n25\t\tmux.HandleFunc(\"GET /repos/o/r/issues/12\", func(w http.ResponseWriter, _ *http.Request) { _, _ = w.Write([]byte(issueFixture)) })\n26\t\tmux.HandleFunc(\"GET /repos/o/r/issues/12/comments\", func(w http.ResponseWriter, _ *http.Request) {\n27\t\t\t_, _ = w.Write([]byte(`[{\"id\": 5, \"user\": {\"login\": \"thomas\", \"id\": 7}, \"body\": \"Also the SHA.\", \"created_at\": \"2026-09-20T09:00:00Z\"}]`))\n28\t\t})\n29\t\tc := newTestClient(t, mux)\n30\t\ttk, err := c.Get(context.Background(), \"HD-12\")\n31\t\tif err != nil {\n32\t\t\tt.Fatal(err)\n33\t\t}\n34\t\tif tk.Key != \"HD-12\" || tk.Summary != \"Add --version\" || tk.Description != \"Print the version.\" || tk.URL != \"https://github.com/o/r/issues/12\" {\n35\t\t\tt.Errorf(\"ticket = %+v\", tk)\n36\t\t}\n37\t\tif tk.Status != \"hive:ready\" || len(tk.Labels) != 2 {\n38\t\t\tt.Errorf(\"status/labels = %q %v\", tk.Status, tk.Labels)\n39\t\t}\n40\t\tif tk.Claim == nil || tk.Claim.AgentID != \"worker-b\" || !tk.Claim.At.Equal(time.Date(2026, 9, 20, 10, 0, 0, 0, time.UTC)) {\n41\t\t\tt.Errorf(\"claim = %+v\", tk.Claim)\n42\t\t}\n43\t\tif len(tk.Comments) != 1 || tk.Co