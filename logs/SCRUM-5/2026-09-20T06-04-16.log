, _ *http.Request) { _, _ = w.Write([]byte(`[]`)) })\n39\t\tmux.HandleFunc(\"GET /repos/{o}/{r}/issues/{n}\", func(w http.ResponseWriter, _ *http.Request) {\n40\t\t\t_, _ = w.Write([]byte(`{\"number\":1,\"title\":\"x\",\"body\":\"hello\",\"labels\":[{\"name\":\"hive:ready\"}],\"updated_at\":\"2026-09-20T10:00:00Z\"}`))\n41\t\t})\n42\t\tmux.HandleFunc(\"PATCH /repos/{o}/{r}/issues/{n}\", func(w http.ResponseWriter, r *http.Request) {\n43\t\t\tvar b map[string]string\n44\t\t\t_ = json.NewDecoder(r.Body).Decode(&b)\n45\t\t\tif b[\"body\"] != \"hello\" {\n46\t\t\t\tw.WriteHeader(400) // the probe must not change anything\n47\t\t\t\treturn\n48\t\t\t}\n49\t\t\tif readOnlyToken {\n50\t\t\t\tw.WriteHeader(403)\n51\t\t\t\t_, _ = w.Write([]byte(`{\"message\":\"Resource not accessible by personal access token\"}`))\n52\t\t\t\treturn\n53\t\t\t}\n54\t\t\t_, _ = w.Write([]byte(`{}`))\n55\t\t})\n56\t\treturn mux\n57\t}\n58\t\n59\tvar readOnlyToken bool\n60\t\n61\tfunc TestCheckReportsMissingLabels(t *testing.T) {\n62\t\tvar created []string\n63\t\tlabels := map[string][]string{\"o/r\": {\"hive:ready\", \"hive:in-progress\", \"bug\"}, \"o/other\": nil}\n64\t\tc := newTestClient(t, adminMux(labels, &created))\n65\t\trep, err := c.Check(context.Background())\n66\t\tif err != nil {\n67\t\t\tt.Fatal(err)\n68\t\t}\n69\t\tif rep.User != \"thomas\" || rep.SampleTickets != 2 {\n70\t\t\tt.Errorf(\"rep = %+v\", rep)\n71\t\t}\n72\t\tif len(rep.MissingLabels[\"o/r\"]) != 3 || len(rep.MissingLabels[\"o/other\"]) != 5 {\n73\t\t\tt.Errorf(\"missing = %v\", rep.MissingLabels)\n74\t\t}\n75\t\tif rep.OK() {\n76\t\t\tt.Error(\"missing labels must fail the check\")\n77\t\t}\n78\t\tif rep.NotWritable != \"\" {\n79\t\t\tt.Errorf(\"token writes fine here: %q\", rep.NotWritable)\n80\t\t}\n81\t}\n82\t\n83\tfunc TestCheckDetectsReadOnlyToken(t *testing.T) {\n84\t\treadOnlyToken = true\n85\t\tt.Cleanup(func() { readOnlyToken = false })\n86\t\tvar created []string\n87\t\tlabels := map[string][]string{\"o/r\":