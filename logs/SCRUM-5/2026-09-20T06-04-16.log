{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01415gJjz2mcH8gZTx4KNTf5","type":"tool_result","content":"1\tpackage ghissues\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"net/http\"\n7\t\t\"net/http/httptest\"\n8\t\t\"testing\"\n9\t\n10\t\t\"github.com/thomasmeadows/hivedispatch/internal/config\"\n11\t\t\"github.com/thomasmeadows/hivedispatch/internal/tracker\"\n12\t)\n13\t\n14\tfunc testCfg(url string) config.GitHubConfig {\n15\t\treturn config.GitHubConfig{APIURL: url, Token: \"tok\", Labels: config.GitHubLabels{\n16\t\t\tReady: \"hive:ready\", InProgress: \"hive:in-progress\", NeedsInfo: \"hive:needs-info\",\n17\t\t\tInReview: \"hive:in-review\", NeedsHuman: \"hive:needs-human\",\n18\t\t}}\n19\t}\n20\t\n21\tvar testRepos = []config.RepoConfig{\n22\t\t{Name: \"o/r\", Project: \"HD\"},\n23\t\t{Name: \"o/other\", Project: \"OT\"},\n24\t}\n25\t\n26\tfunc newTestClient(t *testing.T, mux *http.ServeMux, opts ...Option) *Client {\n27\t\tt.Helper()\n28\t\tsrv := httptest.NewServer(mux)\n29\t\tt.Cleanup(srv.Close)\n30\t\tc, err := New(testCfg(srv.URL), testRepos, opts...)\n31\t\tif err != nil {\n32\t\t\tt.Fatal(err)\n33\t\t}\n34\t\treturn c\n35\t}\n36\t\n37\tfunc TestKeyMapping(t *testing.T) {\n38\t\tc := newTestClient(t, http.NewServeMux())\n39\t\trepo, n, err := c.keyToRef(\"HD-12\")\n40\t\tif err != nil || repo != \"o/r\" || n != 12 {\n41\t\t\tt.Errorf(\"keyToRef = %q %d %v\", repo, n, err)\n42\t\t}\n43\t\tif _, _, err := c.keyToRef(\"NOPE-1\"); err == nil {\n44\t\t\tt.Error(\"unknown project should error\")\n45\t\t}\n46\t\tif _, _, err := c.keyToRef(\"HD-x\"); err == nil {\n47\t\t\tt.Error(\"non-numeric should error\")\n48\t\t}\n49\t\tif key, ok := c.refToKey(\"o/other\", 3); !ok || key != \"OT-3\" {\n50\t\t\tt.Errorf(\"refToKey = %q %v\", key, ok)\n51\t\t}\n52\t}\n53\t\n54\tfunc TestDoMapsNotFound(t *testing.T) {\n55\t\tmux := http.NewServeMux()\n56\t\tmux.HandleFunc(\"GET /repos/o/r/issues/99\", func(w http.ResponseWriter, _ *http.Request) {\n57\t\t\tw.WriteHeader(404)\n58\t\t\t_, _ = w.Write([]byte(`{\"message\":\"Not Found\"}`))\n59\t\t})\n60\t\tc := newTestClient(t, mux)\n61\t\t_, err := c.Get(context.Background(), \"HD-99\")\n62\t\tif !errors.Is(err, tracker.ErrNotFound) {\n63\t\t\tt.Errorf(\"err = %v\", err)\n64\t\t}\n65\t}\n66\t"}]},"parent_tool_use_id":null,"session_id":"2daaed25-284e-4780-838f-5b169e1711d5","uuid":"ecf5bb0b-478a-4349-9305-ac777ae063a3","timestamp":"2026-09-20T05:57:21.495Z","tool_use_result":{"type":"text","file":{"filePath":"/home/thomas/.local/share/hivedispatch/repos/thomasmeadows__HiveDispatch/SCRUM-5/internal/tracker/ghissues/client_test.go","content":"package ghissues\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"testing\"\n\n\t\"github.com/thomasmeadows/hivedispatch/internal/config\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/tracker\"\n)\n\nfunc testCfg(url string) config.GitHubConfig {\n\treturn config.GitHubConfig{APIURL: url, Token: \"tok\", Labels: config.GitHubLabels{\n\t\tReady: \"hive:ready\", InProgress: \"hive:in-progress\", NeedsInfo: \"hive:needs-info\",\n\t\tInReview: \"hive:in-review\", NeedsHuman: \"hive:needs-human\",\n\t}}\n}\n\nvar testRepos = []config.RepoConfig{\n\t{Name: \"o/r\", Project: \"HD\"},\n\t{Name: \"o/other\", Project: \"OT\"},\n}\n\nfunc newTestClient(t *testing.T, mux *http.ServeMux, opts ...Option) *Client {\n\tt.Helper()\n\tsrv := httptest.NewServer(mux)\n\tt.Cleanup(srv.Close)\n\tc, err := New(testCfg(srv.URL), testRepos, opts...)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn c\n}\n\nfunc TestKeyMapping(t *testing.T) {\n\tc := newTestClient(t, http.NewServeMux())\n\trepo, n, err := c.keyToRef(\"HD-12\")\n\tif err != nil || repo != \"o/r\" || n != 12 {\n\t\tt.Errorf(\"keyToRef = %q %d %v\", repo, n, err)\n\t}\n\tif _, _, err := c.keyToRef(\"NOPE-1\"); err == nil {\n\t\tt.Error(\"unknown project should error\")\n\t}\n\tif _, _, err := c.keyToRef(\"HD-x\"); err == nil {\n\t\tt.Error(\"non-numeric should error\")\n\t}\n\tif key, ok := c.refToKey(\"o/other\", 3); !ok || key != \"OT-3\" {\n\t\tt.Errorf(\"refToKey = %q %v\", key, ok)\n\t}\n}\n\nfunc TestDoMapsNotFound(t *testing.T) {\n\tmux := http.NewServeMux()\n\tmux.HandleFunc(\"GET /repos/o/r/issues/99\", func(w http.ResponseWriter, _ *http.Request) {\n\t\tw.WriteHeader(404)\n\t\t_, _ = w.Write([]byte(`{\"message\":\"Not Found\"}`))\n\t})\n\tc := newTestClient(t, mux)\n\t_, err := c.Get(context.Background(), \"HD-99\")\n\tif !errors.Is(err, tracker.ErrNotFound) {\n\t\tt.Errorf(\"err = %v\", err)\n\t}\n}\n","numLines":66,"startLine":1,"totalLines":66}}}
