 != \"HD-1,HD-2,OT-7\" {\n76\t\t\tt.Errorf(\"keys = %v\", keys)\n77\t\t}\n78\t}\n79\t\n80\tfunc TestCommentAndTransition(t *testing.T) {\n81\t\tmux := http.NewServeMux()\n82\t\tvar posted string\n83\t\tvar removed []string\n84\t\tvar added []string\n85\t\tmux.HandleFunc(\"POST /repos/o/r/issues/12/comments\", func(w http.ResponseWriter, r *http.Request) {\n86\t\t\tvar b map[string]string\n87\t\t\t_ = json.NewDecoder(r.Body).Decode(&b)\n88\t\t\tposted = b[\"body\"]\n89\t\t\tw.WriteHeader(201)\n90\t\t\t_, _ = w.Write([]byte(`{\"id\": 1}`))\n91\t\t})\n92\t\tmux.HandleFunc(\"GET /repos/o/r/issues/12\", func(w http.ResponseWriter, _ *http.Request) { _, _ = w.Write([]byte(issueFixture)) })\n93\t\tmux.HandleFunc(\"DELETE /repos/o/r/issues/12/labels/{name}\", func(w http.ResponseWriter, r *http.Request) {\n94\t\t\tremoved = append(removed, r.PathValue(\"name\"))\n95\t\t\t_, _ = w.Write([]byte(`[]`))\n96\t\t})\n97\t\tmux.HandleFunc(\"POST /repos/o/r/issues/12/labels\", func(w http.ResponseWriter, r *http.Request) {\n98\t\t\tvar b struct{ Labels []string }\n99\t\t\t_ = json.NewDecoder(r.Body).Decode(&b)\n100\t\t\tadded = append(added, b.Labels...)\n101\t\t\t_, _ = w.Write([]byte(`[]`))\n102\t\t})\n103\t\tc := newTestClient(t, mux)\n104\t\tif err := c.Comment(context.Background(), \"HD-12\", \"hello **world**\"); err != nil || posted != \"hello **world**\" {\n105\t\t\tt.Errorf(\"comment: %v posted=%q\", err, posted)\n106\t\t}\n107\t\tif err := c.Transition(context.Background(), \"HD-12\", tracker.StateInProgress); err != nil {\n108\t\t\tt.Fatal(err)\n109\t\t}\n110\t\tif len(removed) != 1 || removed[0] != \"hive:ready\" {\n111\t\t\tt.Errorf(\"removed = %v (bug must stay)\", removed)\n112\t\t}\n113\t\tif len(added) != 1 || added[0] != \"hive:in-progress\" {\n114\t\t\tt.Errorf(\"added = %v\", added)\n115\t\t}\n116\t\tif err := c.Transition(context.Background(), \"HD-12\", tracker.State(\"bogus\")); err == nil {\n117\t\t\tt.Error(\"invalid state must error\")\n118\t\t}\n119\t}\n12