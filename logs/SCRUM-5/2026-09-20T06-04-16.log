{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K3picfkNfNzvZ2dEequuMh","type":"tool_result","content":"1\tpackage ghissues\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"fmt\"\n6\t\t\"net/http\"\n7\t\t\"net/url\"\n8\t\t\"strconv\"\n9\t\t\"strings\"\n10\t\t\"time\"\n11\t\n12\t\t\"github.com/thomasmeadows/hivedispatch/internal/tracker\"\n13\t)\n14\t\n15\t// maxPages bounds pagination per request so a misbehaving API cannot spin us.\n16\tconst maxPages = 5\n17\t\n18\ttype issueJSON struct {\n19\t\tNumber      int    `json:\"number\"`\n20\t\tTitle       string `json:\"title\"`\n21\t\tBody        string `json:\"body\"`\n22\t\tHTMLURL     string `json:\"html_url\"`\n23\t\tUpdatedAt   string `json:\"updated_at\"`\n24\t\tPullRequest *struct {\n25\t\t\tURL string `json:\"url\"`\n26\t\t} `json:\"pull_request\"`\n27\t\tLabels []struct {\n28\t\t\tName string `json:\"name\"`\n29\t\t} `json:\"labels\"`\n30\t}\n31\t\n32\ttype commentJSON struct {\n33\t\tID   int64 `json:\"id\"`\n34\t\tUser struct {\n35\t\t\tLogin string `json:\"login\"`\n36\t\t\tID    int64  `json:\"id\"`\n37\t\t} `json:\"user\"`\n38\t\tBody      string `json:\"body\"`\n39\t\tCreatedAt string `json:\"created_at\"`\n40\t}\n41\t\n42\t// stateLabels returns the configured state labels in State order.\n43\tfunc (c *Client) stateLabels() map[tracker.State]string {\n44\t\tl := c.cfg.Labels\n45\t\treturn map[tracker.State]string{\n46\t\t\ttracker.StateReady:      l.Ready,\n47\t\t\ttracker.StateInProgress: l.InProgress,\n48\t\t\ttracker.StateNeedsInfo:  l.NeedsInfo,\n49\t\t\ttracker.StateInReview:   l.InReview,\n50\t\t\ttracker.StateNeedsHuman: l.NeedsHuman,\n51\t\t}\n52\t}\n53\t\n54\tfunc (c *Client) isStateLabel(name string) bool {\n55\t\tfor _, l := range c.stateLabels() {\n56\t\t\tif strings.EqualFold(l, name) {\n57\t\t\t\treturn true\n58\t\t\t}\n59\t\t}\n60\t\treturn false\n61\t}\n62\t\n63\t// getAll follows Link: rel=\"next\" pagination, appending into out (a pointer\n64\t// to a slice), for at most maxPages pages.\n65\tfunc (c *Client) getAll(ctx context.Context, path string, collect func([]byte) error) error {\n66\t\tnext := path\n67\t\tfor page := 0; next != \"\" && page < maxPages; page++ {\n68\t\t\tvar raw []byte\n69\t\t\thdr, err := c.doRaw(ctx, next, &raw)\n70\t\t\tif err != nil {\n71\t\t\t\treturn err\n72\t\t\t}\n73\t\t\tif err := collect(raw); err != nil {\n74\t\t\t\treturn err\n75\t\t\t}\n76\t\t\tnext = nextLink(hdr)\n77\t\t}\n78\t\treturn nil\n79\t}\n80\t\n81\t// doRaw is do() for GET returning the raw body.\n82\tfunc (c *Client) doRaw(ctx context.Context, path string, raw *[]byte) (http.Header, error) {\n83\t\tvar buf jsonRaw\n84\t\thdr, err := c.do(ctx, http.MethodGet, path, nil, &buf)\n85\t\t*raw = buf\n86\t\treturn hdr, err\n87\t}\n88\t\n89\t// jsonRaw captures a response body verbatim so pages can be decoded by the caller.\n90\ttype jsonRaw []byte\n91\t\n92\t// UnmarshalJSON implements json.Unmarshaler by copying the bytes.\n93\tfunc (j *jsonRaw) UnmarshalJSON(b []byte) error {\n94\t\t*j = append((*j)[:0], b...)\n95\t\treturn nil\n96\t}\n97\t\n98\t// Poll returns open issues carrying the ready label across every repo.\n99\tfunc (c *Client) Poll(ctx context.Context) ([]tracker.Ticket, error) {\n100\t\tvar out []tracker.Ticket\n101\t\tfor _, repo := range c.repos {\n102\t\t\tq := url.Values{\"state\": {\"open\"}, \"labels\": {c.cfg.Labels.Ready}, \"per_page\": {\"100\"}}\n103\t\t\tvar issues []issueJSON\n104\t\t\terr := c.getAll(ctx, \"/repos/\"+repo.Name+\"/issues?\"+q.Encode(), func(raw []byte) error {\n105\t\t\t\tvar page []issueJSON\n106\t\t\t\tif err := unmarshal(raw, &page); err != nil {\n107\t\t\t\t\treturn err\n108\t\t\t\t}\n109\t\t\t\tissues = append(issues, page...)\n110\t\t\t\treturn nil\n111\t\t\t})\n112\t\t\tif err != nil {\n113\t\t\t\treturn nil, fmt.Errorf(\"poll %s: %w\", repo.Name, err)\n114\t\t\t}\n115\t\t\tfor _, is := range issues {\n116\t\t\t\tif is.PullRequest != nil {\n117\t\t\t\t\tcontinue // the issues API also lists pull requests\n118\t\t\t\t}\n119\t\t\t\ttk, err := c.toTicket(ctx, repo.Name, is)\n120\t\t\t\tif err != nil {\n121\t\t\t\t\treturn nil, err\n122\t\t\t\t}\n123\t\t\t\tout = append(out, tk)\n124\t\t\t}\n125\t\t}\n126\t\treturn out, nil\n127\t}\n128\t\n129\t// Get fetches one issue with its comments.\n130\tfunc (c *Client) Get(ctx context.Context, key string) (tracker.Ticket, error) {\n131\t\trepo, n, err := c.keyToRef(key)\n132\t\tif err != nil {\n133\t\t\treturn tracker.Ticket{}, err\n134\t\t}\n135\t\tvar is issueJSON\n136\t\tif _, err := c.do(ctx, http.MethodGet, issuePath(repo, n, \"\"), nil, &is); err != nil {\n137\t\t\treturn tracker.Ticket{}, err\n138\t\t}\n139\t\treturn c.toTicket(ctx, repo, is)\n140\t}\n141\t\n142\tfunc (c *Client) toTicket(ctx context.Context, repo string, is issueJSON) (tracker.Ticket, error) {\n143\t\tkey, _ := c.refToKey(repo, is.Number)\n144\t\tbody, claim := splitMarker(is.Body)\n145\t\tt := tracker.Ticket{\n146\t\t\tKey: key, Summary: is.Title, Description: body, URL: is.HTMLURL,\n147\t\t\tStatus: \"open\", Claim: claim, Updated: parseTime(is.UpdatedAt),\n148\t\t}\n149\t\tfor _, l := range is.Labels {\n150\t\t\tt.Labels = append(t.Labels, l.Name)\n151\t\t\tif c.isStateLabel(l.Name) {\n152\t\t\t\tt.Status = l.Name\n153\t\t\t}\n154\t\t}\n155\t\terr := c.getAll(ctx, issuePath(repo, is.Number, \"/comments?per_page=100\"), func(raw []byte) error {\n156\t\t\tvar page []commentJSON\n157\t\t\tif err := unmarshal(raw, &page); err != nil {\n158\t\t\t\treturn err\n159\t\t\t}\n160\t\t\tfor _, cm := range page {\n161\t\t\t\tt.Comments = append(t.Comments, tracker.Comment{\n162\t\t\t\t\tID: strconv.FormatInt(cm.ID, 10), AuthorID: strconv.FormatInt(cm.User.ID, 10),\n163\t\t\t\t\tAuthor: cm.User.Login, Body: cm.Body, Created: parseTime(cm.CreatedAt),\n164\t\t\t\t})\n165\t\t\t}\n166\t\t\treturn nil\n167\t\t})\n168\t\tif err != nil {\n169\t\t\treturn tracker.Ticket{}, fmt.Errorf(\"comments %s: %w\", key, err)\n170\t\t}\n171\t\treturn t, nil\n172\t}\n173\t\n174\t// Comment posts a Markdown comment.\n175\tfunc (c *Client) Comment(ctx context.Context, key, body string) error {\n176\t\trepo, n, err := c.keyToRef(key)\n177\t\tif err != nil {\n178\t\t\treturn err\n179\t\t}\n180\t\t_, err = c.do(ctx, http.MethodPost, issuePath(repo, n, \"/comments\"), map[string]string{\"body\": body}, nil)\n181\t\treturn err\n182\t}\n183\t\n184\t// Transition swaps the issue's state label: every other state label is\n185\t// removed, then the target is added. Non-state labels are untouched.\n186\tfunc (c *Client) Transition(ctx context.Context, key string, to tracker.State) error {\n187\t\ttarget, ok := c.stateLabels()[to]\n188\t\tif !ok || target == \"\" {\n189\t\t\treturn fmt.Errorf(\"ghissues: unknown state %q\", to)\n190\t\t}\n191\t\trepo, n, err := c.keyToRef(key)\n192\t\tif err != nil {\n193\t\t\treturn err\n194\t\t}\n195\t\tvar is issueJSON\n196\t\tif _, err := c.do(ctx, http.MethodGet, issuePath(repo, n, \"\"), nil, &is); err != nil {\n197\t\t\treturn err\n198\t\t}\n199\t\tfor _, l := range is.Labels {\n200\t\t\tif c.isStateLabel(l.Name) && !strings.EqualFold(l.Name, target) {\n201\t\t\t\tif _, err := c.do(ctx, http.MethodDelete, issuePath(repo, n, \"/labels/\"+url.PathEscape(l.Name)), nil, nil); err != nil {\n202\t\t\t\t\treturn fmt.Errorf(\"remove label %s: %w\", l.Name, err)\n203\t\t\t\t}\n204\t\t\t}\n205\t\t}\n206\t\t_, err = c.do(ctx, http.MethodPost, issuePath(repo, n, \"/labels\"), map[string][]string{\"labels\": {target}}, nil)\n207\t\treturn err\n208\t}\n209\t\n210\tfunc parseTime(s string) time.Time {\n211\t\tt, err := time.Parse(time.RFC3339, s)\n212\t\tif err != nil {\n213\t\t\treturn time.Time{}\n214\t\t}\n215\t\treturn t.UTC()\n216\t}\n217\t"}]},"parent_tool_use_id":null,"session_id":"2daaed25-284e-4780-838f-5b169e1711d5","uuid":"6408f258-7867-4277-b1d7-509cd807cfb0","timestamp":"2026-09-20T05:57:07.882Z","tool_use_result":{"type":"text","file":{"filePath":"/home/thomas/.local/share/hivedispatch/repos/thomasmeadows__HiveDispatch/SCRUM-5/internal/tracker/ghissues/issues.go","content":"package ghissues\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/thomasmeadows/hivedispatch/internal/tracker\"\n)\n\n// maxPages bounds pagination per request so a misbehaving API cannot spin us.\nconst maxPages = 5\n\ntype issueJSON struct {\n\tNumber      int    `json:\"number\"`\n\tTitle       string `json:\"title\"`\n\tBody        string `json:\"body\"`\n\tHTMLURL     string `json:\"html_url\"`\n\tUpdatedAt   string `json:\"updated_at\"`\n\tPullRequest *struct {\n\t\tURL string `json:\"url\"`\n\t} `json:\"pull_request\"`\n\tLabels []struct {\n\t\tName string `json:\"name\"`\n\t} `json:\"labels\"`\n}\n\ntype commentJSON struct {\n\tID   int64 `json:\"id\"`\n\tUser struct {\n\t\tLogin string `json:\"login\"`\n\t\tID    int64  `json:\"id\"`\n\t} `json:\"user\"`\n\tBody      string `json:\"body\"`\n\tCreatedAt string `json:\"created_at\"`\n}\n\n// stateLabels returns the configured state labels in State order.\nfunc (c *Client) stateLabels() map[tracker.State]string {\n\tl := c.cfg.Labels\n\treturn map[tracker.State]string{\n\t\ttracker.StateReady:      l.Ready,\n\t\ttracker.StateInProgress: l.InProgress,\n\t\ttracker.StateNeedsInfo:  l.NeedsInfo,\n\t\ttracker.StateInReview:   l.InReview,\n\t\ttracker.StateNeedsHuman: l.NeedsHuman,\n\t}\n}\n\nfunc (c *Client) isStateLabel(name string) bool {\n\tfor _, l := range c.stateLabels() {\n\t\tif strings.EqualFold(l, name) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// getAll follows Link: rel=\"next\" pagination, appending into out (a pointer\n// to a slice), for at most maxPages pages.\nfunc (c *Client) getAll(ctx context.Context, path string, collect func([]byte) error) error {\n\tnext := path\n\tfor page := 0; next != \"\" && page < maxPages; page++ {\n\t\tvar raw []byte\n\t\thdr, err := c.doRaw(ctx, next, &raw)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := collect(raw); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tnext = nextLink(hdr)\n\t}\n\treturn nil\n}\n\n// doRaw is do() for GET returning the raw body.\nfunc (c *Client) doRaw(ctx context.Context, path string, raw *[]byte) (http.Header, error) {\n\tvar buf jsonRaw\n\thdr, err := c.do(ctx, http.MethodGet, path, nil, &buf)\n\t*raw = buf\n\treturn hdr, err\n}\n\n// jsonRaw captures a response body verbatim so pages can be decoded by the caller.\ntype jsonRaw []byte\n\n// UnmarshalJSON implements json.Unmarshaler by copying the bytes.\nfunc (j *jsonRaw) UnmarshalJSON(b []byte) error {\n\t*j = append((*j)[:0], b...)\n\treturn nil\n}\n\n// Poll returns open issues carrying the ready label across every repo.\nfunc (c *Client) Poll(ctx context.Context) ([]tracker.Ticket, error) {\n\tvar out []tracker.Ticket\n\tfor _, repo := range c.repos {\n\t\tq := url.Values{\"state\": {\"open\"}, \"labels\": {c.cfg.Labels.Ready}, \"per_page\": {\"100\"}}\n\t\tvar issues []issueJSON\n\t\terr := c.getAll(ctx, \"/repos/\"+repo.Name+\"/issues?\"+q.Encode(), func(raw []byte) error {\n\t\t\tvar page []issueJSON\n\t\t\tif err := unmarshal(raw, &page); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tissues = append(issues, page...)\n\t\t\treturn nil\n\t\t})\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"poll %s: %w\", repo.Name, err)\n\t\t}\n\t\tfor _, is := range issues {\n\t\t\tif is.PullRequest != nil {\n\t\t\t\tcontinue // the issues API also lists pull requests\n\t\t\t}\n\t\t\ttk, err := c.toTicket(ctx, repo.Name, is)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t\tout = append(out, tk)\n\t\t}\n\t}\n\treturn out, nil\n}\n\n// Get fetches one issue with its comments.\nfunc (c *Client) Get(ctx context.Context, key string) (tracker.Ticket, error) {\n\trepo, n, err := c.keyToRef(key)\n\tif err != nil {\n\t\treturn tracker.Ticket{}, err\n\t}\n\tvar is issueJSON\n\tif _, err := c.do(ctx, http.MethodGet, issuePath(repo, n, \"\"), nil, &is); err != nil {\n\t\treturn tracker.Ticket{}, err\n\t}\n\treturn c.toTicket(ctx, repo, is)\n}\n\nfunc (c *Client) toTicket(ctx context.Context, repo string, is issueJSON) (tracker.Ticket, error) {\n\tkey, _ := c.refToKey(repo, is.Number)\n\tbody, claim := splitMarker(is.Body)\n\tt := tracker.Ticket{\n\t\tKey: key, Summary: is.Title, Description: body, URL: is.HTMLURL,\n\t\tStatus: \"open\", Claim: claim, Updated: parseTime(is.UpdatedAt),\n\t}\n\tfor _, l := range is.Labels {\n\t\tt.Labels = append(t.Labels, l.Name)\n\t\tif c.isStateLabel(l.Name) {\n\t\t\tt.Status = l.Name\n\t\t}\n\t}\n\terr := c.getAll(ctx, issuePath(repo, is.Number, \"/comments?per_page=100\"), func(raw []byte) error {\n\t\tvar page []commentJSON\n\t\tif err := unmarshal(raw, &page); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tfor _, cm := range page {\n\t\t\tt.Comments = append(t.Comments, tracker.Comment{\n\t\t\t\tID: strconv.FormatInt(cm.ID, 10), AuthorID: strconv.FormatInt(cm.User.ID, 10),\n\t\t\t\tAuthor: cm.User.Login, Body: cm.Body, Created: parseTime(cm.CreatedAt),\n\t\t\t})\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn tracker.Ticket{}, fmt.Errorf(\"comments %s: %w\", key, err)\n\t}\n\treturn t, nil\n}\n\n// Comment posts a Markdown comment.\nfunc (c *Client) Comment(ctx context.Context, key, body string) error {\n\trepo, n, err := c.keyToRef(key)\n\tif err != nil {\n\t\treturn err\n\t}\n\t_, err = c.do(ctx, http.MethodPost, issuePath(repo, n, \"/comments\"), map[string]string{\"body\": body}, nil)\n\treturn err\n}\n\n// Transition swaps the issue's state label: every other state label is\n// removed, then the target is added. Non-state labels are untouched.\nfunc (c *Client) Transition(ctx context.Context, key string, to tracker.State) error {\n\ttarget, ok := c.stateLabels()[to]\n\tif !ok || target == \"\" {\n\t\treturn fmt.Errorf(\"ghissues: unknown state %q\", to)\n\t}\n\trepo, n, err := c.keyToRef(key)\n\tif err != nil {\n\t\treturn err\n\t}\n\tvar is issueJSON\n\tif _, err := c.do(ctx, http.MethodGet, issuePath(repo, n, \"\"), nil, &is); err != nil {\n\t\treturn err\n\t}\n\tfor _, l := range is.Labels {\n\t\tif c.isStateLabel(l.Name) && !strings.EqualFold(l.Name, target) {\n\t\t\tif _, err := c.do(ctx, http.MethodDelete, issuePath(repo, n, \"/labels/\"+url.PathEscape(l.Name)), nil, nil); err != nil {\n\t\t\t\treturn fmt.Errorf(\"remove label %s: %w\", l.Name, err)\n\t\t\t}\n\t\t}\n\t}\n\t_, err = c.do(ctx, http.MethodPost, issuePath(repo, n, \"/labels\"), map[string][]string{\"labels\": {target}}, nil)\n\treturn err\n}\n\nfunc parseTime(s string) time.Time {\n\tt, err := time.Parse(time.RFC3339, s)\n\tif err != nil {\n\t\treturn time.Time{}\n\t}\n\treturn t.UTC()\n}\n","numLines":217,"startLine":1,"totalLines":217}}}
