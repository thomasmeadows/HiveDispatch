{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q3pUV99WnF1yvYPopXPkdF","type":"tool_result","content":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t\t\"testing\"\n9\t)\n10\t\n11\tfunc TestVersion(t *testing.T) {\n12\t\tvar out, errb bytes.Buffer\n13\t\tif code := run([]string{\"version\"}, &out, &errb); code != 0 {\n14\t\t\tt.Fatalf(\"exit %d, stderr %s\", code, errb.String())\n15\t\t}\n16\t\tif !strings.HasPrefix(out.String(), \"hivedispatch \") {\n17\t\t\tt.Errorf(\"stdout = %q\", out.String())\n18\t\t}\n19\t}\n20\t\n21\tfunc TestNoArgsPrintsUsage(t *testing.T) {\n22\t\tvar out, errb bytes.Buffer\n23\t\tif code := run(nil, &out, &errb); code != 2 {\n24\t\t\tt.Fatalf(\"exit %d, want 2\", code)\n25\t\t}\n26\t\tif !strings.Contains(errb.String(), \"usage\") {\n27\t\t\tt.Errorf(\"stderr = %q\", errb.String())\n28\t\t}\n29\t}\n30\t\n31\tfunc TestCheckValidConfig(t *testing.T) {\n32\t\tt.Setenv(\"HIVE_JIRA_TOKEN\", \"secret\")\n33\t\tt.Setenv(\"HIVE_GITHUB_TOKEN\", \"gh\")\n34\t\tp := filepath.Join(t.TempDir(), \"c.yaml\")\n35\t\tif err := os.WriteFile(p, []byte(`\n36\tagent_id: w\n37\tjira:\n38\t  base_url: https://x.atlassian.net\n39\t  email: a@b.c\n40\t  jql: project = X\n41\t  fields: {agent_id: customfield_1, claimed_at: customfield_2}\n42\trepos:\n43\t  - {name: o/r, url: git@github.com:o/r.git, jira_project: X}\n44\t`), 0o600); err != nil {\n45\t\t\tt.Fatal(err)\n46\t\t}\n47\t\tvar out, errb bytes.Buffer\n48\t\tif code := run([]string{\"check\", \"-config\", p}, &out, &errb); code != 0 {\n49\t\t\tt.Fatalf(\"exit %d: %s\", code, errb.String())\n50\t\t}\n51\t\tif !strings.Contains(out.String(), \"config ok\") {\n52\t\t\tt.Errorf(\"stdout = %q\", out.String())\n53\t\t}\n54\t}\n55\t\n56\tfunc TestCheckInvalidConfig(t *testing.T) {\n57\t\tt.Setenv(\"HIVE_JIRA_TOKEN\", \"\")\n58\t\tp := filepath.Join(t.TempDir(), \"c.yaml\")\n59\t\tif err := os.WriteFile(p, []byte(\"agent_id: w