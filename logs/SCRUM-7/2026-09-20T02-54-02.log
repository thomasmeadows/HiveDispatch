{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012g4icYvrauiHFqoATLVcem","type":"tool_result","content":"1\t// Command hivedispatch is the HiveDispatch worker CLI.\n2\tpackage main\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"errors\"\n7\t\t\"flag\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"log/slog\"\n11\t\t\"os\"\n12\t\t\"os/signal\"\n13\t\t\"path/filepath\"\n14\t\t\"strings\"\n15\t\t\"syscall\"\n16\t\n17\t\t\"github.com/thomasmeadows/hivedispatch/internal/config\"\n18\t\t\"github.com/thomasmeadows/hivedispatch/internal/dispatch\"\n19\t\t\"github.com/thomasmeadows/hivedispatch/internal/executor\"\n20\t\t\"github.com/thomasmeadows/hivedispatch/internal/executor/claudecode\"\n21\t\texfake \"github.com/thomasmeadows/hivedispatch/internal/executor/fake\"\n22\t\t\"github.com/thomasmeadows/hivedispatch/internal/githost\"\n23\t\t\"github.com/thomasmeadows/hivedispatch/internal/githost/github\"\n24\t\t\"github.com/thomasmeadows/hivedispatch/internal/githost/none\"\n25\t\tgitws \"github.com/thomasmeadows/hivedispatch/internal/gitops/git\"\n26\t\t\"github.com/thomasmeadows/hivedispatch/internal/schedule\"\n27\t\t\"github.com/thomasmeadows/hivedispatch/internal/state\"\n28\t\t\"github.com/thomasmeadows/hivedispatch/internal/state/gitbranch\"\n29\t\t\"github.com/thomasmeadows/hivedispatch/internal/state/localdir\"\n30\t\t\"github.com/thomasmeadows/hivedispatch/internal/state/router\"\n31\t\t\"github.com/thomasmeadows/hivedispatch/internal/tracker/jira\"\n32\t\t\"github.com/thomasmeadows/hivedispatch/internal/triage\"\n33\t\ttriclaude \"github.com/thomasmeadows/hivedispatch/internal/triage/claudecode\"\n34\t\t\"github.com/thomasmeadows/hivedispatch/internal/triage/passthrough\"\n35\t)\n36\t\n37\t// version is overridden at build time via -ldflags \"-X main.version=...\".\n38\tvar version = \"dev\"\n39\t\n40\tconst usage = `usage: hivedispatch <command> [flags]\n41\t\n42\tcommands:\n43\t  version                     print the version\n44\t  check [-config P] [-jira]   validate the worker config; -jira verifies against the live site\n45\t  init  [-config P]           write a commented starter config (never overwrites)\n46\t  init  -jira [-config P]     create the claim custom fields in Jira and print their IDs\n47\t  run   [-config P] [-once] [-executor claude|fake] [-triage claude|passthrough]\n48\t        [-placeholder] [-skip-preflight]\n49\t                              verify Jira setup, then poll and dispatch; -executor and -triage override the config\n50\t                              (-placeholder makes the fake executor write a file so\n51\t                              the branch/PR path is exercised)\n52\t`\n53\t\n54\tfunc main() {\n55\t\tos.Exit(run(os.Args[1:], os.Stdout, os.Stderr))\n56\t}\n57\t\n58\tfunc run(args []string, stdout, stderr io.Writer) int {\n59\t\tif len(args) == 0 {\n60\t\t\tfmt.Fprint(stderr, usage)\n61\t\t\treturn 2\n62\t\t}\n63\t\tswitch args[0] {\n64\t\tcase \"version\":\n65\t\t\tfmt.Fprintf(stdout, \"hivedispatch %s\\n\", version)\n66\t\t\treturn 0\n67\t\tcase \"check\":\n68\t\t\treturn runCheck(args[1:], stdout, stderr)\n69\t\tcase \"init\":\n70\t\t\treturn runInit(args[1:], stdout, stderr)\n71\t\tcase \"run\":\n72\t\t\treturn runRun(args[1:], stdout, stderr)\n73\t\tdefault:\n74\t\t\tfmt.Fprintf(stderr, \"unknown command %q\\n\\n%s\", args[0], usage)\n75\t\t\treturn 2\n76\t\t}\n77\t}\n78\t\n79\tfunc runCheck(args []string, stdout, stderr io.Writer) int {\n80\t\tfs := flag.NewFlagSet(\"check\", flag.ContinueOnError)\n81\t\tfs.SetOutput(stderr)\n82\t\tcfgPath := fs.String(\"config\", config.DefaultPath(), \"path to worker config\")\n83\t\tlive := fs.Bool(\"jira\", false, \"also verify against the live Jira site\")\n84\t\tif err := fs.Parse(args); err != nil {\n85\t\t\treturn 2\n86\t\t}\n87\t\tcfg, err := config.Load(*cfgPath)\n88\t\tif err != nil {\n89\t\t\tfmt.Fprintln(stderr, err)\n90\t\t\treturn 1\n91\t\t}\n92\t\tfmt.Fprintf(stdout, \"config ok: agent %s, %d repo(s), jira %s\\n\", cfg.AgentID, len(cfg.Repos), cfg.Jira.BaseURL)\n93\t\tif _, src := github.DiscoverToken(context.Background(), \"github.com\"); src != \"\" {\n94\t\t\tfmt.Fprintf(stdout, \"github ok: token from %s\\n\", src)\n95\t\t} else {\n96\t\t\tfmt.Fprintln(stdout, \"github: no token found (HIVE_GITHUB_TOKEN, gh auth token, or git credential helper) — branches will be pushed but PRs will not be opened\")\n97\t\t}\n98\t\tif !*live {\n99\t\t\treturn 0\n100\t\t}\n101\t\tclient, err := jira.New(cfg.Jira)\n102\t\tif err != nil {\n103\t\t\tfmt.Fprintln(stderr, err)\n104\t\t\treturn 1\n105\t\t}\n106\t\tif !jiraPreflight(context.Background(), client, cfg, stdout, stderr) {\n107\t\t\treturn 1\n108\t\t}\n109\t\treturn 0\n110\t}\n111\t\n112\t// jiraPreflight runs the live Jira check and prints the report. It returns\n113\t// false when something would prevent a run.\n114\tfunc jiraPreflight(ctx context.Context, client *jira.Client, cfg *config.Config, stdout, stderr io.Writer) bool {\n115\t\tvar projects []string\n116\t\tfor _, r := range cfg.Repos {\n117\t\t\tprojects = append(projects, r.JiraProject)\n118\t\t}\n119\t\trep, err := client.Check(ctx, projects)\n120\t\tif err != nil {\n121\t\t\tfmt.Fprintln(stderr, \"jira check failed:\", err)\n122\t\t\treturn false\n123\t\t}\n124\t\tfmt.Fprintf(stdout, \"jira ok: authenticated as %s; trigger JQL matches %d ticket(s)\\n\", rep.User, rep.SampleTickets)\n125\t\tfor _, p := range rep.UnknownProjects {\n126\t\t\tfmt.Fprintf(stderr, \"repos: jira_project %q does not exist on this site; projects here: %s\\n\", p, strings.Join(rep.Projects, \", \"))\n127\t\t}\n128\t\tfor _, f := range rep.MissingFields {\n129\t\t\tfmt.Fprintf(stderr, \"missing custom field: %s (run `hivedispatch init -jira`)\\n\", f)\n130\t\t}\n131\t\tfor _, d := range rep.DuplicateFields {\n132\t\t\tfmt.Fprintf(stderr, \"warning: several custom fields share a claim-field name (%s); using the lowest id — delete the others in Jira: Settings → Issues → Custom fields\\n\", d)\n133\t\t}\n134\t\tfor _, s := range rep.MissingStatuses {\n135\t\t\tfmt.Fprintf(stderr, \"missing workflow status: %q (see docs/setup.md)\\n\", s)\n136\t\t}\n137\t\tswitch {\n138\t\tcase rep.NotEditableOn != \"\":\n139\t\t\tfmt.Fprintf(stderr, \"claim fields exist but cannot be set on %s.\\n  Team-managed project: Project settings → Issue types → each type → Fields panel → search \\\"HiveDispatch\\\", add both fields, then Save changes.\\n  Company-managed project: add both fields to the project's edit screen.\\n\", rep.NotEditableOn)\n140\t\tcase rep.SampleIssue != \"\":\n141\t\t\tfmt.Fprintf(stdout, \"claim fields are editable (checked on %s)\\n\", rep.SampleIssue)\n142\t\tdefault:\n143\t\t\tfmt.Fprintln(stdout, \"no issue found to verify the claim fields are editable; create one in the project and run check again\")\n144\t\t}\n145\t\treturn rep.OK()\n146\t}\n147\t\n148\tfunc runInit(args []string, stdout, stderr io.Writer) int {\n149\t\tfs := flag.NewFlagSet(\"init\", flag.ContinueOnError)\n150\t\tfs.SetOutput(stderr)\n151\t\tcfgPath := fs.String(\"config\", config.DefaultPath(), \"path to worker config\")\n152\t\tdoJira := fs.Bool(\"jira\", false, \"create the claim custom fields in Jira\")\n153\t\tif err := fs.Parse(args); err != nil {\n154\t\t\treturn 2\n155\t\t}\n156\t\twritten, err := config.WriteStarter(*cfgPath)\n157\t\tif err != nil {\n158\t\t\tfmt.Fprintln(stderr, err)\n159\t\t\treturn 1\n160\t\t}\n161\t\tif written {\n162\t\t\tfmt.Fprintf(stdout, \"wrote starter config to %s\\n\\nEdit it (every field says where its value comes from), export HIVE_JIRA_TOKEN, then run:\\n  hivedispatch init -jira\\n\", *cfgPath)\n163\t\t\tif !*doJira {\n164\t\t\t\treturn 0\n165\t\t\t}\n166\t\t\tfmt.Fprintln(stderr, \"\\ninit -jira: fill in the config first, then run this again.\")\n167\t\t\treturn 1\n168\t\t}\n169\t\tif !*doJira {\n170\t\t\tfmt.Fprintf(stdout, \"config already exists at %s\\nNext: export HIVE_JIRA_TOKEN and run `hivedispatch init -jira`\\n\", *cfgPath)\n171\t\t\treturn 0\n172\t\t}\n173\t\tcfg, err := config.Load(*cfgPath)\n174\t\tif err != nil {\n175\t\t\tfmt.Fprintf(stderr, \"%v\\n\\nEdit %s and run `hivedispatch init -jira` again.\\n\", err, *cfgPath)\n176\t\t\treturn 1\n177\t\t}\n178\t\tclient, err := jira.New(cfg.Jira)\n179\t\tif err != nil {\n180\t\t\tfmt.Fprintln(stderr, err)\n181\t\t\treturn 1\n182\t\t}\n183\t\tids, err := client.EnsureFields(context.Background())\n184\t\tif err != nil {\n185\t\t\tfmt.Fprintln(stderr, \"init failed:\", err)\n186\t\t\treturn 1\n187\t\t}\n188\t\tfmt.Fprintf(stdout, \"jira claim fields ready:\\n  %s = %s  (which worker holds a ticket)\\n  %s = %s  (that worker's last heartbeat)\\n\\nThe worker finds them by name, so nothing needs pasting into %s.\\nNext: hivedispatch check -jira\\n\", jira.FieldNameAgent, ids.AgentID, jira.FieldNameClaimedAt, ids.ClaimedAt, *cfgPath)\n189\t\treturn 0\n190\t}\n191\t\n192\tfunc runRun(args []string, stdout, stderr io.Writer) int {\n193\t\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\n194\t\tfs.SetOutput(stderr)\n195\t\tcfgPath := fs.String(\"config\", config.DefaultPath(), \"path to worker config\")\n196\t\tonce := fs.Bool(\"once\", false, \"poll once and exit\")\n197\t\texecutorFlag := fs.String(\"executor\", \"\", \"override config executor: claude or fake\")\n198\t\ttriageFlag := fs.String(\"triage\", \"\", \"override config triage: claude or passthrough\")\n199\t\tskipPreflight := fs.Bool(\"skip-preflight\", false, \"start without verifying Jira fields, statuses, and projects\")\n200\t\tplaceholder := fs.Bool(\"placeholder\", false, \"fake executor writes a placeholder file so the branch/PR path is exercised\")\n201\t\tif err := fs.Parse(args); err != nil {\n202\t\t\treturn 2\n203\t\t}\n204\t\tcfg, err := config.Load(*cfgPath)\n205\t\tif err != nil {\n206\t\t\tfmt.Fprintln(stderr, err)\n207\t\t\treturn 1\n208\t\t}\n209\t\tlogger := slog.New(slog.NewTextHandler(stderr, nil))\n210\t\ttr, err := jira.New(cfg.Jira)\n211\t\tif err != nil {\n212\t\t\tfmt.Fprintln(stderr, err)\n213\t\t\treturn 1\n214\t\t}\n215\t\tif err := tr.ResolveFields(context.Background()); err != nil {\n216\t\t\tfmt.Fprintln(stderr, err)\n217\t\t\treturn 1\n218\t\t}\n219\t\tif !*skipPreflight && !jiraPreflight(context.Background(), tr, cfg, stdout, stderr) {\n220\t\t\tfmt.Fprintln(stderr, \"not starting: fix the above, or pass -skip-preflight\")\n221\t\t\treturn 1\n222\t\t}\n223\t\tsched, err := schedule.Parse(cfg.RunWindows)\n224\t\tif err != nil {\n225\t\t\tfmt.Fprintln(stderr, err)\n226\t\t\treturn 1\n227\t\t}\n228\t\tctx := context.Background()\n229\t\tws := gitws.New(filepath.Join(cfg.Workroot, \"repos\"))\n230\t\tstores := map[string]state.RunStore{}\n231\t\tfor _, repo := range cfg.Repos {\n232\t\t\tbase, err := ws.EnsureBase(ctx, repo)\n233\t\t\tif err != nil {\n234\t\t\t\tfmt.Fprintln(stderr, err)\n235\t\t\t\treturn 1\n236\t\t\t}\n237\t\t\tvar st state.RunStore\n238\t\t\tif cfg.StateStore == \"local\" {\n239\t\t\t\tst = localdir.New(filepath.Join(cfg.Workroot, \"state\", strings.ReplaceAll(repo.Name, \"/\", \"__\")))\n240\t\t\t} else {\n241\t\t\t\tst, err = gitbranch.Open(ctx, base, filepath.Join(ws.RepoDir(repo), \".state\"))\n242\t\t\t\tif err != nil {\n243\t\t\t\t\tfmt.Fprintln(stderr, \"state branch:\", err)\n244\t\t\t\t\treturn 1\n245\t\t\t\t}\n246\t\t\t}\n247\t\t\tstores[strings.ToUpper(repo.JiraProject)] = st\n248\t\t}\n249\t\tvar host githost.GitHost = none.Host{}\n250\t\tif tok, src := github.DiscoverToken(ctx, \"github.com\"); src != \"\" {\n251\t\t\tcfg.GitHub.Token = tok\n252\t\t\thost, err = github.New(cfg.GitHub)\n253\t\t\tif err != nil {\n254\t\t\t\tfmt.Fprintln(stderr, err)\n255\t\t\t\treturn 1\n256\t\t\t}\n257\t\t\tlogger.Info(\"github token\", \"source\", src)\n258\t\t} else {\n259\t\t\tlogger.Warn(\"no GitHub token found; branches will be pushed but pull requests will not be opened\")\n260\t\t}\n261\t\tname := cfg.Executor\n262\t\tif *executorFlag != \"\" {\n263\t\t\tname = *executorFlag\n264\t\t}\n265\t\tvar ex executor.Executor\n266\t\tswitch name {\n267\t\tcase \"fake\":\n268\t\t\tf := exfake.New()\n269\t\t\tf.Placeholder = *placeholder\n270\t\t\tex = f\n271\t\tcase \"claude\":\n272\t\t\tex = claudecode.New(claudecode.Config{Binary: cfg.Claude.Binary, Model: cfg.Claude.Model})\n273\t\tdefault:\n274\t\t\tfmt.Fprintf(stderr, \"unknown executor %q\\n\", name)\n275\t\t\treturn 2\n276\t\t}\n277\t\ttriKind := cfg.Triage.Kind\n278\t\tif *triageFlag != \"\" {\n279\t\t\ttriKind = *triageFlag\n280\t\t}\n281\t\tvar tri triage.Triager\n282\t\tswitch triKind {\n283\t\tcase \"passthrough\":\n284\t\t\ttri = passthrough.Triager{}\n285\t\tcase \"claude\":\n286\t\t\ttri = triclaude.New(triclaude.Config{Binary: cfg.Claude.Binary, Model: cfg.Triage.Model, StepBudget: cfg.Triage.StepBudget, Timeout: cfg.Triage.Timeout})\n287\t\tdefault:\n288\t\t\tfmt.Fprintf(stderr, \"unknown triage %q\\n\", triKind)\n289\t\t\treturn 2\n290\t\t}\n291\t\td := &dispatch.Dispatcher{\n292\t\t\tCfg:        dispatch.ConfigFrom(cfg),\n293\t\t\tTracker:    tr,\n294\t\t\tTriager:    tri,\n295\t\t\tExecutor:   ex,\n296\t\t\tWorkspaces: ws,\n297\t\t\tHost:       host,\n298\t\t\tStore:      &router.Store{Stores: stores},\n299\t\t\tSchedule:   sched,\n300\t\t\tLog:        logger,\n301\t\t}\n302\t\tlogger.Info(\"starting\", \"agent\", cfg.AgentID, \"executor\", d.Executor.Name(), \"once\", *once)\n303\t\n304\t\t// First signal drains: stop polling, let the current run finish.\n305\t\t// Second signal cancels the run; cleanup still posts comments.\n306\t\tloopCtx, stopLoop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n307\t\tdefer stopLoop()\n308\t\trunCtx, cancelRun := context.WithCancel(context.Background())\n309\t\tdefer cancelRun()\n310\t\tgo func() {\n311\t\t\t<-loopCtx.Done()\n312\t\t\tlogger.Info(\"draining; press Ctrl-C again to interrupt the current run\")\n313\t\t\tstopLoop()\n314\t\t\tsig := make(chan os.Signal, 1)\n315\t\t\tsignal.Notify(sig, os.Interrupt, syscall.SIGTERM)\n316\t\t\t<-sig\n317\t\t\tcancelRun()\n318\t\t}()\n319\t\n320\t\tif *once {\n321\t\t\tn, err := d.Once(runCtx)\n322\t\t\tif err != nil {\n323\t\t\t\tfmt.Fprintln(stderr, err)\n324\t\t\t\treturn 1\n325\t\t\t}\n326\t\t\tfmt.Fprintf(stdout, \"handled %d ticket(s)\\n\", n)\n327\t\t\treturn 0\n328\t\t}\n329\t\tif err := d.Run(loopCtx, runCtx); err != nil && !errors.Is(err, context.Canceled) {\n330\t\t\tfmt.Fprintln(stderr, err)\n331\t\t\treturn 1\n332\t\t}\n333\t\treturn 0\n334\t}\n335\t"}]},"parent_tool_use_id":null,"session_id":"d03743be-102a-4205-897d-42c84124a341","uuid":"83f55d57-5081-4fc0-8d96-6713d221fdd3","timestamp":"2026-09-20T02:46:06.199Z","tool_use_result":{"type":"text","file":{"filePath":"/home/thomas/.local/share/hivedispatch/repos/thomasmeadows__HiveDispatch/SCRUM-7/cmd/hivedispatch/main.go","content":"// Command hivedispatch is the HiveDispatch worker CLI.\npackage main\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"os\"\n\t\"os/signal\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/thomasmeadows/hivedispatch/internal/config\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/dispatch\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/executor\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/executor/claudecode\"\n\texfake \"github.com/thomasmeadows/hivedispatch/internal/executor/fake\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/githost\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/githost/github\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/githost/none\"\n\tgitws \"github.com/thomasmeadows/hivedispatch/internal/gitops/git\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/schedule\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/state\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/state/gitbranch\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/state/localdir\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/state/router\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/tracker/jira\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/triage\"\n\ttriclaude \"github.com/thomasmeadows/hivedispatch/internal/triage/claudecode\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/triage/passthrough\"\n)\n\n// version is overridden at build time via -ldflags \"-X main.version=...\".\nvar version = \"dev\"\n\nconst usage = `usage: hivedispatch <command> [flags]\n\ncommands:\n  version                     print the version\n  check [-config P] [-jira]   validate the worker config; -jira verifies against the live site\n  init  [-config P]           write a commented starter config (never overwrites)\n  init  -jira [-config P]     create the claim custom fields in Jira and print their IDs\n  run   [-config P] [-once] [-executor claude|fake] [-triage claude|passthrough]\n        [-placeholder] [-skip-preflight]\n                              verify Jira setup, then poll and dispatch; -executor and -triage override the config\n                              (-placeholder makes the fake executor write a file so\n                              the branch/PR path is exercised)\n`\n\nfunc main() {\n\tos.Exit(run(os.Args[1:], os.Stdout, os.Stderr))\n}\n\nfunc run(args []string, stdout, stderr io.Writer) int {\n\tif len(args) == 0 {\n\t\tfmt.Fprint(stderr, usage)\n\t\treturn 2\n\t}\n\tswitch args[0] {\n\tcase \"version\":\n\t\tfmt.Fprintf(stdout, \"hivedispatch %s\\n\", version)\n\t\treturn 0\n\tcase \"check\":\n\t\treturn runCheck(args[1:], stdout, stderr)\n\tcase \"init\":\n\t\treturn runInit(args[1:], stdout, stderr)\n\tcase \"run\":\n\t\treturn runRun(args[1:], stdout, stderr)\n\tdefault:\n\t\tfmt.Fprintf(stderr, \"unknown command %q\\n\\n%s\", args[0], usage)\n\t\treturn 2\n\t}\n}\n\nfunc runCheck(args []string, stdout, stderr io.Writer) int {\n\tfs := flag.NewFlagSet(\"check\", flag.ContinueOnError)\n\tfs.SetOutput(stderr)\n\tcfgPath := fs.String(\"config\", config.DefaultPath(), \"path to worker config\")\n\tlive := fs.Bool(\"jira\", false, \"also verify against the live Jira site\")\n\tif err := fs.Parse(args); err != nil {\n\t\treturn 2\n\t}\n\tcfg, err := config.Load(*cfgPath)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tfmt.Fprintf(stdout, \"config ok: agent %s, %d repo(s), jira %s\\n\", cfg.AgentID, len(cfg.Repos), cfg.Jira.BaseURL)\n\tif _, src := github.DiscoverToken(context.Background(), \"github.com\"); src != \"\" {\n\t\tfmt.Fprintf(stdout, \"github ok: token from %s\\n\", src)\n\t} else {\n\t\tfmt.Fprintln(stdout, \"github: no token found (HIVE_GITHUB_TOKEN, gh auth token, or git credential helper) — branches will be pushed but PRs will not be opened\")\n\t}\n\tif !*live {\n\t\treturn 0\n\t}\n\tclient, err := jira.New(cfg.Jira)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tif !jiraPreflight(context.Background(), client, cfg, stdout, stderr) {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\n// jiraPreflight runs the live Jira check and prints the report. It returns\n// false when something would prevent a run.\nfunc jiraPreflight(ctx context.Context, client *jira.Client, cfg *config.Config, stdout, stderr io.Writer) bool {\n\tvar projects []string\n\tfor _, r := range cfg.Repos {\n\t\tprojects = append(projects, r.JiraProject)\n\t}\n\trep, err := client.Check(ctx, projects)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, \"jira check failed:\", err)\n\t\treturn false\n\t}\n\tfmt.Fprintf(stdout, \"jira ok: authenticated as %s; trigger JQL matches %d ticket(s)\\n\", rep.User, rep.SampleTickets)\n\tfor _, p := range rep.UnknownProjects {\n\t\tfmt.Fprintf(stderr, \"repos: jira_project %q does not exist on this site; projects here: %s\\n\", p, strings.Join(rep.Projects, \", \"))\n\t}\n\tfor _, f := range rep.MissingFields {\n\t\tfmt.Fprintf(stderr, \"missing custom field: %s (run `hivedispatch init -jira`)\\n\", f)\n\t}\n\tfor _, d := range rep.DuplicateFields {\n\t\tfmt.Fprintf(stderr, \"warning: several custom fields share a claim-field name (%s); using the lowest id — delete the others in Jira: Settings → Issues → Custom fields\\n\", d)\n\t}\n\tfor _, s := range rep.MissingStatuses {\n\t\tfmt.Fprintf(stderr, \"missing workflow status: %q (see docs/setup.md)\\n\", s)\n\t}\n\tswitch {\n\tcase rep.NotEditableOn != \"\":\n\t\tfmt.Fprintf(stderr, \"claim fields exist but cannot be set on %s.\\n  Team-managed project: Project settings → Issue types → each type → Fields panel → search \\\"HiveDispatch\\\", add both fields, then Save changes.\\n  Company-managed project: add both fields to the project's edit screen.\\n\", rep.NotEditableOn)\n\tcase rep.SampleIssue != \"\":\n\t\tfmt.Fprintf(stdout, \"claim fields are editable (checked on %s)\\n\", rep.SampleIssue)\n\tdefault:\n\t\tfmt.Fprintln(stdout, \"no issue found to verify the claim fields are editable; create one in the project and run check again\")\n\t}\n\treturn rep.OK()\n}\n\nfunc runInit(args []string, stdout, stderr io.Writer) int {\n\tfs := flag.NewFlagSet(\"init\", flag.ContinueOnError)\n\tfs.SetOutput(stderr)\n\tcfgPath := fs.String(\"config\", config.DefaultPath(), \"path to worker config\")\n\tdoJira := fs.Bool(\"jira\", false, \"create the claim custom fields in Jira\")\n\tif err := fs.Parse(args); err != nil {\n\t\treturn 2\n\t}\n\twritten, err := config.WriteStarter(*cfgPath)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tif written {\n\t\tfmt.Fprintf(stdout, \"wrote starter config to %s\\n\\nEdit it (every field says where its value comes from), export HIVE_JIRA_TOKEN, then run:\\n  hivedispatch init -jira\\n\", *cfgPath)\n\t\tif !*doJira {\n\t\t\treturn 0\n\t\t}\n\t\tfmt.Fprintln(stderr, \"\\ninit -jira: fill in the config first, then run this again.\")\n\t\treturn 1\n\t}\n\tif !*doJira {\n\t\tfmt.Fprintf(stdout, \"config already exists at %s\\nNext: export HIVE_JIRA_TOKEN and run `hivedispatch init -jira`\\n\", *cfgPath)\n\t\treturn 0\n\t}\n\tcfg, err := config.Load(*cfgPath)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"%v\\n\\nEdit %s and run `hivedispatch init -jira` again.\\n\", err, *cfgPath)\n\t\treturn 1\n\t}\n\tclient, err := jira.New(cfg.Jira)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tids, err := client.EnsureFields(context.Background())\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, \"init failed:\", err)\n\t\treturn 1\n\t}\n\tfmt.Fprintf(stdout, \"jira claim fields ready:\\n  %s = %s  (which worker holds a ticket)\\n  %s = %s  (that worker's last heartbeat)\\n\\nThe worker finds them by name, so nothing needs pasting into %s.\\nNext: hivedispatch check -jira\\n\", jira.FieldNameAgent, ids.AgentID, jira.FieldNameClaimedAt, ids.ClaimedAt, *cfgPath)\n\treturn 0\n}\n\nfunc runRun(args []string, stdout, stderr io.Writer) int {\n\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\n\tfs.SetOutput(stderr)\n\tcfgPath := fs.String(\"config\", config.DefaultPath(), \"path to worker config\")\n\tonce := fs.Bool(\"once\", false, \"poll once and exit\")\n\texecutorFlag := fs.String(\"executor\", \"\", \"override config executor: claude or fake\")\n\ttriageFlag := fs.String(\"triage\", \"\", \"override config triage: claude or passthrough\")\n\tskipPreflight := fs.Bool(\"skip-preflight\", false, \"start without verifying Jira fields, statuses, and projects\")\n\tplaceholder := fs.Bool(\"placeholder\", false, \"fake executor writes a placeholder file so the branch/PR path is exercised\")\n\tif err := fs.Parse(args); err != nil {\n\t\treturn 2\n\t}\n\tcfg, err := config.Load(*cfgPath)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tlogger := slog.New(slog.NewTextHandler(stderr, nil))\n\ttr, err := jira.New(cfg.Jira)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tif err := tr.ResolveFields(context.Background()); err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tif !*skipPreflight && !jiraPreflight(context.Background(), tr, cfg, stdout, stderr) {\n\t\tfmt.Fprintln(stderr, \"not starting: fix the above, or pass -skip-preflight\")\n\t\treturn 1\n\t}\n\tsched, err := schedule.Parse(cfg.RunWindows)\n\tif err != nil {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\tctx := context.Background()\n\tws := gitws.New(filepath.Join(cfg.Workroot, \"repos\"))\n\tstores := map[string]state.RunStore{}\n\tfor _, repo := range cfg.Repos {\n\t\tbase, err := ws.EnsureBase(ctx, repo)\n\t\tif err != nil {\n\t\t\tfmt.Fprintln(stderr, err)\n\t\t\treturn 1\n\t\t}\n\t\tvar st state.RunStore\n\t\tif cfg.StateStore == \"local\" {\n\t\t\tst = localdir.New(filepath.Join(cfg.Workroot, \"state\", strings.ReplaceAll(repo.Name, \"/\", \"__\")))\n\t\t} else {\n\t\t\tst, err = gitbranch.Open(ctx, base, filepath.Join(ws.RepoDir(repo), \".state\"))\n\t\t\tif err != nil {\n\t\t\t\tfmt.Fprintln(stderr, \"state branch:\", err)\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t\tstores[strings.ToUpper(repo.JiraProject)] = st\n\t}\n\tvar host githost.GitHost = none.Host{}\n\tif tok, src := github.DiscoverToken(ctx, \"github.com\"); src != \"\" {\n\t\tcfg.GitHub.Token = tok\n\t\thost, err = github.New(cfg.GitHub)\n\t\tif err != nil {\n\t\t\tfmt.Fprintln(stderr, err)\n\t\t\treturn 1\n\t\t}\n\t\tlogger.Info(\"github token\", \"source\", src)\n\t} else {\n\t\tlogger.Warn(\"no GitHub token found; branches will be pushed but pull requests will not be opened\")\n\t}\n\tname := cfg.Executor\n\tif *executorFlag != \"\" {\n\t\tname = *executorFlag\n\t}\n\tvar ex executor.Executor\n\tswitch name {\n\tcase \"fake\":\n\t\tf := exfake.New()\n\t\tf.Placeholder = *placeholder\n\t\tex = f\n\tcase \"claude\":\n\t\tex = claudecode.New(claudecode.Config{Binary: cfg.Claude.Binary, Model: cfg.Claude.Model})\n\tdefault:\n\t\tfmt.Fprintf(stderr, \"unknown executor %q\\n\", name)\n\t\treturn 2\n\t}\n\ttriKind := cfg.Triage.Kind\n\tif *triageFlag != \"\" {\n\t\ttriKind = *triageFlag\n\t}\n\tvar tri triage.Triager\n\tswitch triKind {\n\tcase \"passthrough\":\n\t\ttri = passthrough.Triager{}\n\tcase \"claude\":\n\t\ttri = triclaude.New(triclaude.Config{Binary: cfg.Claude.Binary, Model: cfg.Triage.Model, StepBudget: cfg.Triage.StepBudget, Timeout: cfg.Triage.Timeout})\n\tdefault:\n\t\tfmt.Fprintf(stderr, \"unknown triage %q\\n\", triKind)\n\t\treturn 2\n\t}\n\td := &dispatch.Dispatcher{\n\t\tCfg:        dispatch.ConfigFrom(cfg),\n\t\tTracker:    tr,\n\t\tTriager:    tri,\n\t\tExecutor:   ex,\n\t\tWorkspaces: ws,\n\t\tHost:       host,\n\t\tStore:      &router.Store{Stores: stores},\n\t\tSchedule:   sched,\n\t\tLog:        logger,\n\t}\n\tlogger.Info(\"starting\", \"agent\", cfg.AgentID, \"executor\", d.Executor.Name(), \"once\", *once)\n\n\t// First signal drains: stop polling, let the current run finish.\n\t// Second signal cancels the run; cleanup still posts comments.\n\tloopCtx, stopLoop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stopLoop()\n\trunCtx, cancelRun := context.WithCancel(context.Background())\n\tdefer cancelRun()\n\tgo func() {\n\t\t<-loopCtx.Done()\n\t\tlogger.Info(\"draining; press Ctrl-C again to interrupt the current run\")\n\t\tstopLoop()\n\t\tsig := make(chan os.Signal, 1)\n\t\tsignal.Notify(sig, os.Interrupt, syscall.SIGTERM)\n\t\t<-sig\n\t\tcancelRun()\n\t}()\n\n\tif *once {\n\t\tn, err := d.Once(runCtx)\n\t\tif err != nil {\n\t\t\tfmt.Fprintln(stderr, err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"handled %d ticket(s)\\n\", n)\n\t\treturn 0\n\t}\n\tif err := d.Run(loopCtx, runCtx); err != nil && !errors.Is(err, context.Canceled) {\n\t\tfmt.Fprintln(stderr, err)\n\t\treturn 1\n\t}\n\treturn 0\n}\n","numLines":335,"startLine":1,"totalLines":335}}}
