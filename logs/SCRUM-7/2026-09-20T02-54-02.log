\", URL: \"git@x:o/r.git\", DefaultBranch: \"main\", JiraProject: \"HIVE\"}},\n51\t\t\t},\n52\t\t\tTracker: h.tr, Triager: h.tri, Executor: h.ex, Workspaces: h.ws, Host: h.host, Store: h.store,\n53\t\t\tNow: func() time.Time { return now },\n54\t\t\tLog: slog.New(slog.NewTextHandler(io.Discard, nil)),\n55\t\t}\n56\t\th.tr.Add(tracker.Ticket{Key: \"HIVE-1\", Summary: \"one\"})\n57\t\treturn h\n58\t}\n59\t\n60\tfunc (h *harness) handle(t *testing.T) Outcome {\n61\t\tt.Helper()\n62\t\tout, err := h.d.Handle(context.Background(), h.ticket(t))\n63\t\tif err != nil {\n64\t\t\tt.Fatalf(\"Handle: %v\", err)\n65\t\t}\n66\t\treturn out\n67\t}\n68\t\n69\tfunc (h *harness) ticket(t *testing.T) tracker.Ticket {\n70\t\tt.Helper()\n71\t\ttk, err := h.tr.Get(context.Background(), \"HIVE-1\")\n72\t\tif err != nil {\n73\t\t\tt.Fatal(err)\n74\t\t}\n75\t\treturn tk\n76\t}\n77\t\n78\tfunc (h *harness) run(t *testing.T) *state.Run {\n79\t\tt.Helper()\n80\t\tr, err := h.store.Load(context.Background(), \"HIVE-1\")\n81\t\tif err != nil {\n82\t\t\tt.Fatal(err)\n83\t\t}\n84\t\treturn r\n85\t}\n86\t\n87\tfunc (h *harness) assertTransitions(t *testing.T, want ...tracker.State) {\n88\t\tt.Helper()\n89\t\tgot := h.tr.Transitions(\"HIVE-1\")\n90\t\tif len(got) != len(want) {\n91\t\t\tt.Fatalf(\"transitions = %v, want %v\", got, want)\n92\t\t}\n93\t\tfor i := range want {\n94\t\t\tif got[i] != want[i] {\n95\t\t\t\tt.Fatalf(\"transitions = %v, want %v\", got, want)\n96\t\t\t}\n97\t\t}\n98\t}\n99\t\n100\tfunc (h *harness) assertLastComment(t *testing.T, wants ...string) {\n101\t\tt.Helper()\n102\t\tcs := h.tr.Comments(\"HIVE-1\")\n103\t\tif len(cs) == 0 {\n104\t\t\tt.Fatal(\"no comments posted\")\n105\t\t}\n106\t\tlast := cs[len(cs)-1]\n107\t\tfor _, w := range wants {\n108\t\t\tif !strings.Contains(last, w) {\n109\t\t\t\tt.Errorf(\"last comment missing %q:\\n%s\", w, last)\n110\t\t\t}\n111\t\t}\n112\t}\n113\t\n114\tfunc (h *harness) assertReleased(t *testing.T) {\n115\t\tt.Helper()\n116\t\tif c := h.ticket(t).Claim; c != nil {\n117\t\t\tt.Errorf(\"claim not released: %+v\", c)\n118\t\t}\n119\t}\n120\t\n121\tfunc TestHandleSkipsUnknownProject(t *testing.T) {\n122\t\th := newHarness(t)\n123\t\th.tr.Add(tracker.Ticket{Key: \"OTHER-1\"})\n124\t\ttk, _ := h.tr.Get(context.Background(), \"OTHER-1\")\n125\t\tout, err := h.d.Handle(context.Background(), tk)\n126\t\tif err != nil || out != OutcomeSkipped {\n127\t\t\tt.Fatalf(\"out=%v err=%v\", out, err)\n128\t\t}\n129\t\tif got, _ := h.tr.Get(context.Background(), \"OTHER-1\"); got.Claim != nil {\n130\t\t\tt.Error(\"must not claim a ticket with no repo\")\n131\t\t}\n132\t}\n133\t\n134\tfunc TestHandleSkipsFreshForeignClaim(t *testing.T) {\n135\t\th := newHarness(t)\n136\t\th.tr.OverwriteClaim(\"HIVE-1\", \"worker-b\", now.Add(-time.Minute))\n137\t\tif out := h.handle(t); out != OutcomeSkipped {\n138\t\t\tt.Fatalf(\"out = %v\", out)\n139\t\t}\n140\t\tif c := h.ticket(t).Claim; c == nil || c.AgentID != \"worker-b\" {\n141\t\t\tt.Errorf(\"foreign claim disturbed: %+v\", c)\n142\t\t}\n143\t\tif len(h.ex.Calls()) != 0 {\n144\t\t\tt.Error(\"executor must not run\")\n145\t\t}\n146\t}\n147\t\n148\tfunc TestHandleReclaimsStaleClaim(t *testing.T) {\n149\t\th := newHarness(t)\n150\t\th.tr.OverwriteClaim(\"HIVE-1\", \"worker-b\", now.Add(-2*time.Hour))\n151\t\tif out := h.handle(t); out != OutcomeCompleted {\n152\t\t\tt.Fatalf(\"out = %v\", out)\n153\t\t}\n154\t\tif len(h.ex.Calls()) != 1 {\n155\t\t\tt.Error(\"executor should have run after reclaiming a stale claim\")\n156\t\t}\n157\t\th.assertReleased(t)\n158\t}\n159\t\n160\tfunc TestHandleClaimLost(t *testing.T) {\n161\t\th := newHarness(t)\n162\t\th.tr.BeforeReadBack = func(key string) { h.tr.OverwriteClaim(key, \"worker-b\", now.Add(time.Second)) }\n163\t\tif out := h.handle(t); out != OutcomeClaimLost {\n164\t\t\tt.Fatalf(\"out = %v\", out)\n165\t\t}\n166\t\tif len(h.ex.Calls()) != 0 || len(h.tr.Comments(\"HIVE-1\")) != 0 {\n167\t\t\tt.Error(\"loser must do nothing\")\n168\t\t}\n169\t}\n170\t\n171\tfunc TestTriageNeedsInfo(t *testing.T) {\n172\t\th := newHarness(t)\n173\t\th.tri.Decisions[\"HIVE-1\"] = triage.Decision{Kind: triage.KindNeedsInfo, Question: \"Which DB?\"}\n174\t\tif out := h.handle(t); out != OutcomeNeedsInfo {\n175\t\t\tt.Fatalf(\"out = %v\", out)\n176\t\t}\n177\t\th.assertTransitions(t, tracker.StateNeedsInfo)\n178\t\th.assertLastComment(t, Marker, \"Which DB?\")\n179\t\th.assertReleased(t)\n180\t\tif len(h.ex.Calls()) != 0 {\n181\t\t\tt.Error(\"executor must not run\")\n182\t\t}\n183\t\tif r := h.run(t); r.LastStatus != string(executor.StatusNeedsInput) || r.QuestionAt.IsZero() {\n184\t\t\tt.Errorf(\"run = %+v\", r)\n185\t\t}\n186\t}\n187\t\n188\tfunc TestTriageReject(t *testing.T) {\n189\t\th := newHarness(t)\n190\t\th.tri.Decisions[\"HIVE-1\"] = triage.Decision{Kind: triage.KindReject, Reason: \"cross-cutting\"}\n191\t\tif out := h.handle(t); out != OutcomeRejected {\n192\t\t\tt.Fatalf(\"out = %v\", out)\n193\t\t}\n194\t\th.assertTransitions(t, tracker.StateNeedsHuman)\n195\t\th.assertLastComment(t, \"cross-cutting\")\n196\t\th.assertReleased(t)\n197\t}\n198\t\n199\tfunc TestDispatchCompletedWithPR(t *testing.T) {\n200\t\th := newHarness(t)\n201\t\th.ws.Changed[\"HIVE-1\"] = true\n202\t\th.ex.Results[\"HIVE-1\"] = executor.Result{Status: executor.StatusCompleted, Summary: \"added flag\", ResumeToken: \"sess-1\"}\n203\t\tif out := h.handle(t); out != OutcomeCompleted {\n204\t\t\tt.Fatalf(\"out = %v\", out)\n205\t\t}\n206\t\th.assertTransitions(t, tracker.StateInProgress, tracker.StateInReview)\n207\t\topened := h.host.Opened()\n208\t\tif len(opened) != 1 || opened[0].Head != \"hive/HIVE-1\" || opened[0].Base != \"main\" || !strings.Contains(opened[0].Title, \"HIVE-1\") {\n209\t\t\tt.Fatalf(\"opened = %+v\", opened)\n210\t\t}\n211\t\th.assertLastComment(t, \"pull/1\", \"added flag\")\n212\t\tr := h.run(t)\n213\t\tif r.Phase != state.PhaseDone || r.PRURL == \"\" || r.Attempts != 1 || r.ResumeToken != \"sess-1\" || r.Branch != \"hive/HIVE-1\" {\n214\t\t\tt.Errorf(\"run = %+v\", r)\n215\t\t}\n216\t\tcalls := h.ex.Calls()\n217\t\tif len(calls) != 1 || calls[0].Prompt != \"do the thing\" || calls[0].StepBudget != 50 || calls[0].Workspace == \"\" {\n218\t\t\tt.Errorf(\"task = %+v\", calls)\n219\t\t}\n220\t\tif tri := h.tri.Calls(); len(tri) != 1 || tri[0].RepoPath == \"\" {\n221\t\t\tt.Errorf(\"triage must receive the workspace path: %+v\", tri)\n222\t\t}\n223\t\th.assertReleased(t)\n224\t}\n225\t\n226\tfunc TestDispatchCompletedNoChanges(t *testing.T) {\n227\t\th := newHarness(t)\n228\t\tif out := h.handle(t); out != OutcomeCompleted {\n229\t\t\tt.Fatalf(\"out = %v\", out)\n230\t\t}\n231\t\th.assertTransitions(t, tracker.StateInProgress, tracker.StateInReview)\n232\t\tif len(h.host.Opened()) != 0 {\n233\t\t\tt.Error(\"no PR without changes\")\n234\t\t}\n235\t\th.assertLastComment(t, \"no code changes\", exfake.DefaultSummary)\n236\t\th.assertReleased(t)\n237\t}\n238\t\n239\tfunc TestExecutorNeedsInput(t *testing.T) {\n240\t\th := newHarness(t)\n241\t\th.ex.Results[\"HIVE-1\"] = executor.Result{Status: executor.StatusNeedsInput, Question: \"Postgres or SQLite?\", ResumeToken: \"sess-2\"}\n242\t\tif out := h.handle(t); out != OutcomeNeedsInput {\n243\t\t\tt.Fatalf(\"out = %v\", out)\n244\t\t}\n245\t\th.assertTransitions(t, tracker.StateInProgress, tracker.StateNeedsInfo)\n246\t\th.assertLastComment(t, \"Postgres or SQLite?\")\n247\t\tr := h.run(t)\n248\t\tif r.ResumeToken != \"sess-2\" || r.QuestionAt.IsZero() || r.LastStatus != string(executor.StatusNeedsInput) {\n249\t\t\tt.Errorf(\"run = %+v\", r)\n250\t\t}\n251\t\th.assertReleased(t)\n252\t}\n253\t\n254\tfunc TestExecutorFailedRetries(t *testing.T) {\n255\t\tfor _, cause := range []executor.Cause{executor.CauseBudget, executor.CauseStepBudget, executor.CauseError, executor.CauseKilled} {\n256\t\t\tt.Run(string(cause), func(t *testing.T) {\n257\t\t\t\th := newHarness(t)\n258\t\t\t\th.ws.Changed[\"HIVE-1\"] = true\n259\t\t\t\th.ex.Results[\"HIVE-1\"] = executor.Result{Status: executor.StatusFailed, StopCause: cause, Summary: \"partial\"}\n260\t\t\t\tif out := h.handle(t); out != OutcomeFailed {\n261\t\t\t\t\tt.Fatalf(\"out = %v\", out)\n262\t\t\t\t}\n263\t\t\t\th.assertTransitions(t, tracker.StateInProgress, tracker.StateReady)\n264\t\t\t\th.assertLastComment(t, cause.Describe(), \"1 of 3\", \"hive/HIVE-1\", \"partial\")\n265\t\t\t\tif len(h.host.Opened()) != 0 {\n266\t\t\t\t\tt.Error(\"never open a PR from a failed run\")\n267\t\t\t\t}\n268\t\t\t\tr := h.run(t)\n269\t\t\t\tif r.Attempts != 1 || r.StopCause != string(cause) || r.Phase != state.PhasePushed {\n270\t\t\t\t\tt.Errorf(\"run = %+v\", r)\n271\t\t\t\t}\n272\t\t\t\th.assertReleased(t)\n273\t\t\t})\n274\t\t}\n275\t}\n276\t\n277\tfunc TestExecutorFailedExhaustsAttempts(t *testing.T) {\n278\t\th := newHarness(t)\n279\t\tif err := h.store.Save(context.Background(), &state.Run{Ticket: \"HIVE-1\", Attempts: 2}); err != nil {\n280\t\t\tt.Fatal(err)\n281\t\t}\n282\t\th.ex.Results[\"HIVE-1\"] = executor.Result{Status: executor.StatusFailed, StopCause: executor.CauseError}\n283\t\tif out := h.handle(t); out != OutcomeFailed {\n284\t\t\tt.Fatalf(\"out = %v\", out)\n285\t\t}\n286\t\th.assertTransitions(t, tracker.StateInProgress, tracker.StateNeedsHuman)\n287\t\th.assertLastComment(t, \"3 of 3\", \"human\")\n288\t}\n289\t\n290\tfunc TestExecutorErrorIsFailure(t *testing.T) {\n291\t\th := newHarness(t)\n292\t\th.ex.Err[\"HIVE-1\"] = context.Canceled\n293\t\tif out := h.handle(t); out != OutcomeFailed {\n294\t\t\tt.Fatalf(\"out = %v\", out)\n295\t\t}\n296\t\th.assertLastComment(t, executor.CauseError.Describe())\n297\t\tif r := h.run(t); r.StopCause != string(executor.CauseError) {\n298\t\t\tt.Errorf(\"run = %+v\", r)\n299\t\t}\n300\t}\n301\t\n302\tfunc TestExecutorTimeout(t *testing.T) {\n303\t\th := newHarness(t)\n304\t\th.d.Cfg.RunTimeout = 20 * time.Millisecond\n305\t\th.ex.Block[\"HIVE-1\"] = true\n306\t\tif out := h.handle(t); out != OutcomeFailed {\n307\t\t\tt.Fatalf(\"out = %v\", out)\n308\t\t}\n309\t\th.assertLastComment(t, executor.CauseTimeout.Describe())\n310\t\th.assertReleased(t)\n311\t}\n312\t\n313\tfunc TestPROpenFailureReturnsToReady(t *testing.T) {\n314\t\th := newHarness(t)\n315\t\th.ws.Changed[\"HIVE-1\"] = true\n316\t\th.host.Err = context.DeadlineExceeded\n317\t\tout, err := h.d.Handle(context.Background(), h.ticket(t))\n318\t\tif err == nil || out != OutcomeFailed {\n319\t\t\tt.Fatalf(\"out=%v err=%v\", out, err)\n320\t\t}\n321\t\th.assertTransitions(t, tracker.StateInProgress, tracker.StateReady)\n322\t\th.assertLastComment(t, \"opening the PR failed\", \"hive/HIVE-1\")\n323\t\th.assertReleased(t)\n324\t}\n325\t\n326\tfunc TestTriageErrorLeavesTicketReady(t *testing.T) {\n327\t\th := newHarness(t)\n328\t\th.tri.Err = context.DeadlineExceeded\n329\t\tif _, err := h.d.Handle(context.Background(), h.ticket(t)); err == nil {\n330\t\t\tt.Fatal(\"expected error\")\n331\t\t}\n332\t\th.assertTransitions(t)\n333\t\th.assertReleased(t)\n334\t}\n335\t\n336\tfunc TestCompletedWithoutPRHostStillReportsBranch(t *testing.T) {\n337\t\th := newHarness(t)\n338\t\th.ws.Changed[\"HIVE-1\"] = true\n339\t\th.d.Host = nonePRHost{}\n340\t\tif out := h.handle(t); out != OutcomeCompleted {\n341\t\t\tt.Fatalf(\"out = %v\", out)\n342\t\t}\n343\t\th.assertTransitions(t, tracker.StateInProgress, tracker.StateInReview)\n344\t\th.assertLastComment(t, \"hive/HIVE-1\", \"could not open a PR\")\n345\t\tif r := h.run(t); r.PRURL != \"\" || r.Phase != state.PhaseDone {\n346\t\t\tt.Errorf(\"run = %+v\", r)\n347\t\t}\n348\t}\n349\t\n350\t// nonePRHost mirrors githost/none: pushes happen, PRs do not.\n351\ttype nonePRHost struct{}\n352\t\n353\tfunc (nonePRHost) FindPR(context.Context, string, string) (*githost.PR, error) { return nil, nil }\n354\tfunc (nonePRHost) OpenPR(context.Context, string, githost.Request) (*githost.PR, error) {\n355\t\treturn nil, nil\n356\t}\n357\t"}]},"parent_tool_use_id":null,"session_id":"d03743be-1