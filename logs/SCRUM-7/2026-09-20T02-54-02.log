{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E1EofbVG1a8CcK1jrQQHx4","type":"tool_result","content":"1\tpackage dispatch\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"time\"\n8\t\n9\t\t\"github.com/thomasmeadows/hivedispatch/internal/config\"\n10\t\t\"github.com/thomasmeadows/hivedispatch/internal/executor\"\n11\t\t\"github.com/thomasmeadows/hivedispatch/internal/githost\"\n12\t\t\"github.com/thomasmeadows/hivedispatch/internal/gitops\"\n13\t\t\"github.com/thomasmeadows/hivedispatch/internal/prompt\"\n14\t\t\"github.com/thomasmeadows/hivedispatch/internal/state\"\n15\t\t\"github.com/thomasmeadows/hivedispatch/internal/tracker\"\n16\t\t\"github.com/thomasmeadows/hivedispatch/internal/triage\"\n17\t)\n18\t\n19\t// releaseTimeout bounds the cleanup calls made after ctx may be cancelled.\n20\tconst releaseTimeout = 30 * time.Second\n21\t\n22\t// Handle takes one ticket from polled to a terminal state. Every path that\n23\t// claims the ticket also releases it and leaves a comment explaining what\n24\t// happened.\n25\tfunc (d *Dispatcher) Handle(ctx context.Context, t tracker.Ticket) (Outcome, error) {\n26\t\tnow := d.now()\n27\t\trepo, ok := d.repoFor(t.Key)\n28\t\tif !ok {\n29\t\t\td.log().Warn(\"no repo configured for ticket\", \"ticket\", t.Key)\n30\t\t\treturn OutcomeSkipped, nil\n31\t\t}\n32\t\tif t.Claim.Fresh(now, d.Cfg.ClaimTimeout) && t.Claim.AgentID != d.Cfg.AgentID {\n33\t\t\treturn OutcomeSkipped, nil\n34\t\t}\n35\t\twon, err := d.Tracker.Claim(ctx, t.Key, d.Cfg.AgentID, now)\n36\t\tif err != nil {\n37\t\t\treturn OutcomeSkipped, fmt.Errorf(\"claim %s: %w\", t.Key, err)\n38\t\t}\n39\t\tif !won {\n40\t\t\treturn OutcomeClaimLost, nil\n41\t\t}\n42\t\tdefer d.release(ctx, t.Key)\n43\t\n44\t\trun, err := d.Store.Load(ctx, t.Key)\n45\t\tif err != nil {\n46\t\t\treturn OutcomeSkipped, fmt.Errorf(\"load run %s: %w\", t.Key, err)\n47\t\t}\n48\t\trun.Agent = d.Cfg.AgentID\n49\t\trun.Branch = gitops.BranchName(t.Key)\n50\t\td.setPhase(ctx, run, state.PhaseClaimed)\n51\t\n52\t\trunCtx, cancel := context.WithCancel(ctx)\n53\t\tdefer cancel()\n54\t\tgo d.heartbeat(runCtx, t.Key, cancel)\n55\t\n56\t\t// The worktree comes first: triage needs a checkout to inspect, and a\n57\t\t// dispatched run works in the same one.\n58\t\tws, err := d.Workspaces.Prepare(ctx, repo, t.Key)\n59\t\tif err != nil {\n60\t\t\trun.Attempts++\n61\t\t\tres := executor.Result{Status: executor.StatusFailed, StopCause: executor.CauseError, Summary: \"workspace: \" + err.Error()}\n62\t\t\treturn d.finishFailed(ctx, t, run, res, false), nil\n63\t\t}\n64\t\n65\t\t// Resume after a human reply, or triage afresh.\n66\t\tvar taskPrompt string\n67\t\tif d.canResume(t, run) {\n68\t\t\ttaskPrompt = prompt.RenderResume(t, run.QuestionAt, isOurs)\n69\t\t\td.event(ctx, run, \"resume\", \"\")\n70\t\t} else {\n71\t\t\tdec, err := d.Triager.Decide(ctx, triage.Input{\n72\t\t\t\tTicket: t, Repo: repo, Branch: run.Branch, RepoPath: ws.Path,\n73\t\t\t\tAttempts: run.Attempts, LastStopCause: run.StopCause,\n74\t\t\t})\n75\t\t\tif err != nil {\n76\t\t\t\treturn OutcomeSkipped, fmt.Errorf(\"triage %s: %w\", t.Key, err)\n77\t\t\t}\n78\t\t\tswitch dec.Kind {\n79\t\t\tcase triage.KindNeedsInfo:\n80\t\t\t\trun.LastStatus = string(executor.StatusNeedsInput)\n81\t\t\t\trun.QuestionAt = now\n82\t\t\t\td.save(ctx, run)\n83\t\t\t\td.comment(ctx, t.Key, reportTriageNeedsInfo(dec.Question))\n84\t\t\t\td.transition(ctx, t.Key, tracker.StateNeedsInfo)\n85\t\t\t\td.event(ctx, run, \"triage_needs_info\", dec.Question)\n86\t\t\t\treturn OutcomeNeedsInfo, nil\n87\t\t\tcase triage.KindReject:\n88\t\t\t\td.comment(ctx, t.Key, reportRejected(dec.Reason))\n89\t\t\t\td.transition(ctx, t.Key, tracker.StateNeedsHuman)\n90\t\t\t\td.event(ctx, run, \"triage_reject\", dec.Reason)\n91\t\t\t\treturn OutcomeRejected, nil\n92\t\t\tcase triage.KindDispatch:\n93\t\t\t\ttaskPrompt = dec.Prompt\n94\t\t\tdefault:\n95\t\t\t\treturn OutcomeSkipped, fmt.Errorf(\"triage %s: unknown decision %q\", t.Key, dec.Kind)\n96\t\t\t}\n97\t\t}\n98\t\n99\t\td.transition(ctx, t.Key, tracker.StateInProgress)\n100\t\treturn d.execute(runCtx, t, repo, run, ws, taskPrompt)\n101\t}\n102\t\n103\t// canResume reports whether the last run asked a question that a human has\n104\t// since answered.\n105\tfunc (d *Dispatcher) canResume(t tracker.Ticket, run *state.Run) bool {\n106\t\tif run.LastStatus != string(executor.StatusNeedsInput) || run.ResumeToken == \"\" || run.QuestionAt.IsZero() {\n107\t\t\treturn false\n108\t\t}\n109\t\tfor _, c := range t.Comments {\n110\t\t\tif c.Created.After(run.QuestionAt) && !isOurs(c) {\n111\t\t\t\treturn true\n112\t\t\t}\n113\t\t}\n114\t\treturn false\n115\t}\n116\t\n117\t// execute runs the executor and reports the result. ctx is the run context:\n118\t// cancelled on shutdown or on losing the claim.\n119\tfunc (d *Dispatcher) execute(ctx context.Context, t tracker.Ticket, repo config.RepoConfig, run *state.Run, ws gitops.Workspace, taskPrompt string) (Outcome, error) {\n120\t\trun.Attempts++\n121\t\td.setPhase(ctx, run, state.PhaseWorking)\n122\t\n123\t\texecCtx, cancelExec := context.WithTimeout(ctx, d.Cfg.RunTimeout)\n124\t\tres, err := d.Executor.Run(execCtx, executor.Task{\n125\t\t\tTicketKey: t.Key, Prompt: taskPrompt, Workspace: ws.Path,\n126\t\t\tResumeToken: run.ResumeToken, StepBudget: d.Cfg.StepBudget,\n127\t\t})\n128\t\tcancelExec()\n129\t\tif err != nil {\n130\t\t\tres = executor.Result{Status: executor.StatusFailed, StopCause: executor.CauseError, Summary: err.Error()}\n131\t\t}\n132\t\tif res.Status == executor.StatusFailed && res.StopCause == executor.CauseNone {\n133\t\t\tres.StopCause = executor.CauseError\n134\t\t}\n135\t\tif res.ResumeToken != \"\" {\n136\t\t\trun.ResumeToken = res.ResumeToken\n137\t\t}\n138\t\trun.LastStatus = string(res.Status)\n139\t\trun.StopCause = string(res.StopCause)\n140\t\tif res.Log != \"\" {\n141\t\t\tif _, err := d.Store.WriteLog(ctx, t.Key, d.now().UTC().Format(\"2006-01-02T15-04-05\"), res.Log); err != nil {\n142\t\t\t\td.log().Warn(\"write log failed\", \"ticket\", t.Key, \"err\", err)\n143\t\t\t}\n144\t\t}\n145\t\n146\t\t// Safety commit and push: the guarantee that every stop point is safe.\n147\t\tbg := d.background(ctx)\n148\t\tmsg := \"hive: checkpoint\"\n149\t\tif res.Status != executor.StatusCompleted {\n150\t\t\tmsg = fmt.Sprintf(\"hive: WIP (%s)\", res.StopCause)\n151\t\t}\n152\t\tpushed, ferr := d.Workspaces.Finalize(bg, ws, msg)\n153\t\tif ferr != nil {\n154\t\t\td.log().Error(\"finalize failed\", \"ticket\", t.Key, \"err\", ferr)\n155\t\t}\n156\t\tif pushed {\n157\t\t\td.setPhase(bg, run, state.PhasePushed)\n158\t\t}\n159\t\n160\t\tswitch res.Status {\n161\t\tcase executor.StatusCompleted:\n162\t\t\tvar pr *githost.PR\n163\t\t\tif pushed {\n164\t\t\t\tpr, err = d.ensurePR(bg, repo, t, run)\n165\t\t\t\tif err != nil {\n166\t\t\t\t\td.comment(bg, t.Key, reportPRFailed(err, run.Branch))\n167\t\t\t\t\td.transition(bg, t.Key, tracker.StateReady)\n168\t\t\t\t\td.event(bg, run, \"pr_failed\", err.Error())\n169\t\t\t\t\treturn OutcomeFailed, fmt.Errorf(\"open PR for %s: %w\", t.Key, err)\n170\t\t\t\t}\n171\t\t\t\tif pr != nil {\n172\t\t\t\t\trun.PRURL = pr.URL\n173\t\t\t\t\td.setPhase(bg, run, state.PhasePROpened)\n174\t\t\t\t}\n175\t\t\t}\n176\t\t\td.comment(bg, t.Key, reportCompleted(res, pr, run.Branch, pushed))\n177\t\t\td.transition(bg, t.Key, tracker.StateInReview)\n178\t\t\td.setPhase(bg, run, state.PhaseDone)\n179\t\t\td.event(bg, run, \"completed\", res.Summary)\n180\t\t\treturn OutcomeCompleted, nil\n181\t\tcase executor.StatusNeedsInput:\n182\t\t\trun.QuestionAt = d.now()\n183\t\t\td.save(bg, run)\n184\t\t\td.comment(bg, t.Key, reportNeedsInput(res.Question))\n185\t\t\td.transition(bg, t.Key, tracker.StateNeedsInfo)\n186\t\t\td.event(bg, run, \"needs_input\", res.Question)\n187\t\t\treturn OutcomeNeedsInput, nil\n188\t\tdefault:\n189\t\t\treturn d.finishFailed(bg, t, run, res, pushed), nil\n190\t\t}\n191\t}\n192\t\n193\tfunc (d *Dispatcher) finishFailed(ctx context.Context, t tracker.Ticket, run *state.Run, res executor.Result, pushed bool) Outcome {\n194\t\trun.LastStatus = string(executor.StatusFailed)\n195\t\trun.StopCause = string(res.StopCause)\n196\t\texhausted := run.Attempts >= d.Cfg.MaxAttempts\n197\t\td.save(ctx, run)\n198\t\td.comment(ctx, t.Key, reportFailed(res, run.Attempts, d.Cfg.MaxAttempts, run.Branch, pushed, exhausted, d.now()))\n199\t\tif exhausted {\n200\t\t\td.transition(ctx, t.Key, tracker.StateNeedsHuman)\n201\t\t} else {\n202\t\t\td.transition(ctx, t.Key, tracker.StateReady)\n203\t\t}\n204\t\td.event(ctx, run, \"failed\", res.Summary)\n205\t\treturn OutcomeFailed\n206\t}\n207\t\n208\tfunc (d *Dispatcher) ensurePR(ctx context.Context, repo config.RepoConfig, t tracker.Ticket, run *state.Run) (*githost.PR, error) {\n209\t\tpr, err := d.Host.FindPR(ctx, repo.Name, run.Branch)\n210\t\tif err != nil {\n211\t\t\treturn nil, err\n212\t\t}\n213\t\tif pr != nil {\n214\t\t\treturn pr, nil\n215\t\t}\n216\t\tbody := fmt.Sprintf(\"Resolves %s.\\n\\n%s\\n\\nOpened by HiveDispatch worker %s.\", t.Key, t.URL, d.Cfg.AgentID)\n217\t\treturn d.Host.OpenPR(ctx, repo.Name, githost.Request{\n218\t\t\tTitle: fmt.Sprintf(\"%s: %s\", t.Key, t.Summary),\n219\t\t\tBody:  body,\n220\t\t\tHead:  run.Branch,\n221\t\t\tBase:  repo.DefaultBranch,\n222\t\t})\n223\t}\n224\t\n225\t// heartbeat refreshes the claim until ctx ends. Losing the claim cancels\n226\t// the run: someone else now owns the ticket.\n227\tfunc (d *Dispatcher) heartbeat(ctx context.Context, key string, lost context.CancelFunc) {\n228\t\ttick := time.NewTicker(d.Cfg.HeartbeatInterval)\n229\t\tdefer tick.Stop()\n230\t\tfor {\n231\t\t\tselect {\n232\t\t\tcase <-ctx.Done():\n233\t\t\t\treturn\n234\t\t\tcase <-tick.C:\n235\t\t\t\terr := d.Tracker.Heartbeat(ctx, key, d.Cfg.AgentID)\n236\t\t\t\tif errors.Is(err, tracker.ErrNotClaimHolder) {\n237\t\t\t\t\td.log().Error(\"claim lost mid-run; cancelling\", \"ticket\", key)\n238\t\t\t\t\tlost()\n239\t\t\t\t\treturn\n240\t\t\t\t}\n241\t\t\t\tif err != nil && ctx.Err() == nil {\n242\t\t\t\t\td.log().Warn(\"heartbeat failed\", \"ticket\", key, \"err\", err)\n243\t\t\t\t}\n244\t\t\t}\n245\t\t}\n246\t}\n247\t\n248\t// background returns a context that survives ctx's cancellation so cleanup\n249\t// (comments, transitions, release) still happens after a hard stop. Each\n250\t// tracker call is already bounded by the client's own request timeout.\n251\tfunc (d *Dispatcher) background(ctx context.Context) context.Context {\n252\t\treturn context.WithoutCancel(ctx)\n253\t}\n254\t\n255\tfunc (d *Dispatcher) release(ctx context.Context, key string) {\n256\t\tbg, cancel := context.WithTimeout(d.background(ctx), releaseTimeout)\n257\t\tdefer cancel()\n258\t\terr := d.Tracker.Release(bg, key, d.Cfg.AgentID)\n259\t\tif err != nil && !errors.Is(err, tracker.ErrNotClaimHolder) {\n260\t\t\td.log().Error(\"release failed\", \"ticket\", key, \"err\", err)\n261\t\t}\n262\t}\n263\t\n264\tfunc (d *Dispatcher) comment(ctx context.Context, key, body string) {\n265\t\tif err := d.Tracker.Comment(ctx, key, body); err != nil {\n266\t\t\td.log().Error(\"comment failed\", \"ticket\", key, \"err\", err)\n267\t\t}\n268\t}\n269\t\n270\tfunc (d *Dispatcher) transition(ctx context.Context, key string, to tracker.State) {\n271\t\tif err := d.Tracker.Transition(ctx, key, to); err != nil {\n272\t\t\td.log().Error(\"transition failed\", \"ticket\", key, \"to\", to, \"err\", err)\n273\t\t}\n274\t}\n275\t\n276\tfunc (d *Dispatcher) setPhase(ctx context.Context, run *state.Run, p state.Phase) {\n277\t\trun.Phase = p\n278\t\td.save(ctx, run)\n279\t}\n280\t\n281\tfunc (d *Dispatcher) save(ctx context.Context, run *state.Run) {\n282\t\tif err := d.Store.Save(ctx, run); err != nil {\n283\t\t\td.log().Error(\"save run failed\", \"ticket\", run.Ticket, \"err\", err)\n284\t\t}\n285\t}\n286\t\n287\tfunc (d *Dispatcher) event(ctx context.Context, run *state.Run, ev, msg string) {\n288\t\te := state.LogEntry{Time: d.now(), Agent: d.Cfg.AgentID, Event: ev, Phase: string(run.Phase), Cause: run.StopCause, Message: msg}\n289\t\tif err := d.Store.AppendLog(ctx, run.Ticket, e); err != nil {\n290\t\t\td.log().Error(\"append log failed\", \"ticket\", run.Ticket, \"err\", err)\n291\t\t}\n292\t}\n293\t"}]},"parent_tool_use_id":null,"session_id":"d03743be-102a-4205-897d-42c84124a341","uuid":"9a16f578-d1b4-41ec-9175-0a58193e1c33","timestamp":"2026-09-20T02:46:05.318Z","tool_use_result":{"type":"text","file":{"filePath":"/home/thomas/.local/share/hivedispatch/repos/thomasmeadows__HiveDispatch/SCRUM-7/internal/dispatch/handle.go","content":"package dispatch\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"time\"\n\n\t\"github.com/thomasmeadows/hivedispatch/internal/config\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/executor\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/githost\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/gitops\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/prompt\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/state\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/tracker\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/triage\"\n)\n\n// releaseTimeout bounds the cleanup calls made after ctx may be cancelled.\nconst releaseTimeout = 30 * time.Second\n\n// Handle takes one ticket from polled to a terminal state. Every path that\n// claims the ticket also releases it and leaves a comment explaining what\n// happened.\nfunc (d *Dispatcher) Handle(ctx context.Context, t tracker.Ticket) (Outcome, error) {\n\tnow := d.now()\n\trepo, ok := d.repoFor(t.Key)\n\tif !ok {\n\t\td.log().Warn(\"no repo configured for ticket\", \"ticket\", t.Key)\n\t\treturn OutcomeSkipped, nil\n\t}\n\tif t.Claim.Fresh(now, d.Cfg.ClaimTimeout) && t.Claim.AgentID != d.Cfg.AgentID {\n\t\treturn OutcomeSkipped, nil\n\t}\n\twon, err := d.Tracker.Claim(ctx, t.Key, d.Cfg.AgentID, now)\n\tif err != nil {\n\t\treturn OutcomeSkipped, fmt.Errorf(\"claim %s: %w\", t.Key, err)\n\t}\n\tif !won {\n\t\treturn OutcomeClaimLost, nil\n\t}\n\tdefer d.release(ctx, t.Key)\n\n\trun, err := d.Store.Load(ctx, t.Key)\n\tif err != nil {\n\t\treturn OutcomeSkipped, fmt.Errorf(\"load run %s: %w\", t.Key, err)\n\t}\n\trun.Agent = d.Cfg.AgentID\n\trun.Branch = gitops.BranchName(t.Key)\n\td.setPhase(ctx, run, state.PhaseClaimed)\n\n\trunCtx, cancel := context.WithCancel(ctx)\n\tdefer cancel()\n\tgo d.heartbeat(runCtx, t.Key, cancel)\n\n\t// The worktree comes first: triage needs a checkout to inspect, and a\n\t// dispatched run works in the same one.\n\tws, err := d.Workspaces.Prepare(ctx, repo, t.Key)\n\tif err != nil {\n\t\trun.Attempts++\n\t\tres := executor.Result{Status: executor.StatusFailed, StopCause: executor.CauseError, Summary: \"workspace: \" + err.Error()}\n\t\treturn d.finishFailed(ctx, t, run, res, false), nil\n\t}\n\n\t// Resume after a human reply, or triage afresh.\n\tvar taskPrompt string\n\tif d.canResume(t, run) {\n\t\ttaskPrompt = prompt.RenderResume(t, run.QuestionAt, isOurs)\n\t\td.event(ctx, run, \"resume\", \"\")\n\t} else {\n\t\tdec, err := d.Triager.Decide(ctx, triage.Input{\n\t\t\tTicket: t, Repo: repo, Branch: run.Branch, RepoPath: ws.Path,\n\t\t\tAttempts: run.Attempts, LastStopCause: run.StopCause,\n\t\t})\n\t\tif err != nil {\n\t\t\treturn OutcomeSkipped, fmt.Errorf(\"triage %s: %w\", t.Key, err)\n\t\t}\n\t\tswitch dec.Kind {\n\t\tcase triage.KindNeedsInfo:\n\t\t\trun.LastStatus = string(executor.StatusNeedsInput)\n\t\t\trun.QuestionAt = now\n\t\t\td.save(ctx, run)\n\t\t\td.comment(ctx, t.Key, reportTriageNeedsInfo(dec.Question))\n\t\t\td.transition(ctx, t.Key, tracker.StateNeedsInfo)\n\t\t\td.event(ctx, run, \"triage_needs_info\", dec.Question)\n\t\t\treturn OutcomeNeedsInfo, nil\n\t\tcase triage.KindReject:\n\t\t\td.comment(ctx, t.Key, reportRejected(dec.Reason))\n\t\t\td.transition(ctx, t.Key, tracker.StateNeedsHuman)\n\t\t\td.event(ctx, run, \"triage_reject\", dec.Reason)\n\t\t\treturn OutcomeRejected, nil\n\t\tcase triage.KindDispatch:\n\t\t\ttaskPrompt = dec.Prompt\n\t\tdefault:\n\t\t\treturn OutcomeSkipped, fmt.Errorf(\"triage %s: unknown decision %q\", t.Key, dec.Kind)\n\t\t}\n\t}\n\n\td.transition(ctx, t.Key, tracker.StateInProgress)\n\treturn d.execute(runCtx, t, repo, run, ws, taskPrompt)\n}\n\n// canResume reports whether the last run asked a question that a human has\n// since answered.\nfunc (d *Dispatcher) canResume(t tracker.Ticket, run *state.Run) bool {\n\tif run.LastStatus != string(executor.StatusNeedsInput) || run.ResumeToken == \"\" || run.QuestionAt.IsZero() {\n\t\treturn false\n\t}\n\tfor _, c := range t.Comments {\n\t\tif c.Created.After(run.QuestionAt) && !isOurs(c) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// execute runs the executor and reports the result. ctx is the run context:\n// cancelled on shutdown or on losing the claim.\nfunc (d *Dispatcher) execute(ctx context.Context, t tracker.Ticket, repo config.RepoConfig, run *state.Run, ws gitops.Workspace, taskPrompt string) (Outcome, error) {\n\trun.Attempts++\n\td.setPhase(ctx, run, state.PhaseWorking)\n\n\texecCtx, cancelExec := context.WithTimeout(ctx, d.Cfg.RunTimeout)\n\tres, err := d.Executor.Run(execCtx, executor.Task{\n\t\tTicketKey: t.Key, Prompt: taskPrompt, Workspace: ws.Path,\n\t\tResumeToken: run.ResumeToken, StepBudget: d.Cfg.StepBudget,\n\t})\n\tcancelExec()\n\tif err != nil {\n\t\tres = executor.Result{Status: executor.StatusFailed, StopCause: executor.CauseError, Summary: err.Error()}\n\t}\n\tif res.Status == executor.StatusFailed && res.StopCause == executor.CauseNone {\n\t\tres.StopCause = executor.CauseError\n\t}\n\tif res.ResumeToken != \"\" {\n\t\trun.ResumeToken = res.ResumeToken\n\t}\n\trun.LastStatus = string(res.Status)\n\trun.StopCause = string(res.StopCause)\n\tif res.Log != \"\" {\n\t\tif _, err := d.Store.WriteLog(ctx, t.Key, d.now().UTC().Format(\"2006-01-02T15-04-05\"), res.Log); err != nil {\n\t\t\td.log().Warn(\"write log failed\", \"ticket\", t.Key, \"err\", err)\n\t\t}\n\t}\n\n\t// Safety commit and push: the guarantee that every stop point is safe.\n\tbg := d.background(ctx)\n\tmsg := \"hive: checkpoint\"\n\tif res.Status != executor.StatusCompleted {\n\t\tmsg = fmt.Sprintf(\"hive: WIP (%s)\", res.StopCause)\n\t}\n\tpushed, ferr := d.Workspaces.Finalize(bg, ws, msg)\n\tif ferr != nil {\n\t\td.log().Error(\"finalize failed\", \"ticket\", t.Key, \"err\", ferr)\n\t}\n\tif pushed {\n\t\td.setPhase(bg, run, state.PhasePushed)\n\t}\n\n\tswitch res.Status {\n\tcase executor.StatusCompleted:\n\t\tvar pr *githost.PR\n\t\tif pushed {\n\t\t\tpr, err = d.ensurePR(bg, repo, t, run)\n\t\t\tif err != nil {\n\t\t\t\td.comment(bg, t.Key, reportPRFailed(err, run.Branch))\n\t\t\t\td.transition(bg, t.Key, tracker.StateReady)\n\t\t\t\td.event(bg, run, \"pr_failed\", err.Error())\n\t\t\t\treturn OutcomeFailed, fmt.Errorf(\"open PR for %s: %w\", t.Key, err)\n\t\t\t}\n\t\t\tif pr != nil {\n\t\t\t\trun.PRURL = pr.URL\n\t\t\t\td.setPhase(bg, run, state.PhasePROpened)\n\t\t\t}\n\t\t}\n\t\td.comment(bg, t.Key, reportCompleted(res, pr, run.Branch, pushed))\n\t\td.transition(bg, t.Key, tracker.StateInReview)\n\t\td.setPhase(bg, run, state.PhaseDone)\n\t\td.event(bg, run, \"completed\", res.Summary)\n\t\treturn OutcomeCompleted, nil\n\tcase executor.StatusNeedsInput:\n\t\trun.QuestionAt = d.now()\n\t\td.save(bg, run)\n\t\td.comment(bg, t.Key, reportNeedsInput(res.Question))\n\t\td.transition(bg, t.Key, tracker.StateNeedsInfo)\n\t\td.event(bg, run, \"needs_input\", res.Question)\n\t\treturn OutcomeNeedsInput, nil\n\tdefault:\n\t\treturn d.finishFailed(bg, t, run, res, pushed), nil\n\t}\n}\n\nfunc (d *Dispatcher) finishFailed(ctx context.Context, t tracker.Ticket, run *state.Run, res executor.Result, pushed bool) Outcome {\n\trun.LastStatus = string(executor.StatusFailed)\n\trun.StopCause = string(res.StopCause)\n\texhausted := run.Attempts >= d.Cfg.MaxAttempts\n\td.save(ctx, run)\n\td.comment(ctx, t.Key, reportFailed(res, run.Attempts, d.Cfg.MaxAttempts, run.Branch, pushed, exhausted, d.now()))\n\tif exhausted {\n\t\td.transition(ctx, t.Key, tracker.StateNeedsHuman)\n\t} else {\n\t\td.transition(ctx, t.Key, tracker.StateReady)\n\t}\n\td.event(ctx, run, \"failed\", res.Summary)\n\treturn OutcomeFailed\n}\n\nfunc (d *Dispatcher) ensurePR(ctx context.Context, repo config.RepoConfig, t tracker.Ticket, run *state.Run) (*githost.PR, error) {\n\tpr, err := d.Host.FindPR(ctx, repo.Name, run.Branch)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif pr != nil {\n\t\treturn pr, nil\n\t}\n\tbody := fmt.Sprintf(\"Resolves %s.\\n\\n%s\\n\\nOpened by HiveDispatch worker %s.\", t.Key, t.URL, d.Cfg.AgentID)\n\treturn d.Host.OpenPR(ctx, repo.Name, githost.Request{\n\t\tTitle: fmt.Sprintf(\"%s: %s\", t.Key, t.Summary),\n\t\tBody:  body,\n\t\tHead:  run.Branch,\n\t\tBase:  repo.DefaultBranch,\n\t})\n}\n\n// heartbeat refreshes the claim until ctx ends. Losing the claim cancels\n// the run: someone else now owns the ticket.\nfunc (d *Dispatcher) heartbeat(ctx context.Context, key string, lost context.CancelFunc) {\n\ttick := time.NewTicker(d.Cfg.HeartbeatInterval)\n\tdefer tick.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-tick.C:\n\t\t\terr := d.Tracker.Heartbeat(ctx, key, d.Cfg.AgentID)\n\t\t\tif errors.Is(err, tracker.ErrNotClaimHolder) {\n\t\t\t\td.log().Error(\"claim lost mid-run; cancelling\", \"ticket\", key)\n\t\t\t\tlost()\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif err != nil && ctx.Err() == nil {\n\t\t\t\td.log().Warn(\"heartbeat failed\", \"ticket\", key, \"err\", err)\n\t\t\t}\n\t\t}\n\t}\n}\n\n// background returns a context that survives ctx's cancellation so cleanup\n// (comments, transitions, release) still happens after a hard stop. Each\n// tracker call is already bounded by the client's own request timeout.\nfunc (d *Dispatcher) background(ctx context.Context) context.Context {\n\treturn context.WithoutCancel(ctx)\n}\n\nfunc (d *Dispatcher) release(ctx context.Context, key string) {\n\tbg, cancel := context.WithTimeout(d.background(ctx), releaseTimeout)\n\tdefer cancel()\n\terr := d.Tracker.Release(bg, key, d.Cfg.AgentID)\n\tif err != nil && !errors.Is(err, tracker.ErrNotClaimHolder) {\n\t\td.log().Error(\"release failed\", \"ticket\", key, \"err\", err)\n\t}\n}\n\nfunc (d *Dispatcher) comment(ctx context.Context, key, body string) {\n\tif err := d.Tracker.Comment(ctx, key, body); err != nil {\n\t\td.log().Error(\"comment failed\", \"ticket\", key, \"err\", err)\n\t}\n}\n\nfunc (d *Dispatcher) transition(ctx context.Context, key string, to tracker.State) {\n\tif err := d.Tracker.Transition(ctx, key, to); err != nil {\n\t\td.log().Error(\"transition failed\", \"ticket\", key, \"to\", to, \"err\", err)\n\t}\n}\n\nfunc (d *Dispatcher) setPhase(ctx context.Context, run *state.Run, p state.Phase) {\n\trun.Phase = p\n\td.save(ctx, run)\n}\n\nfunc (d *Dispatcher) save(ctx context.Context, run *state.Run) {\n\tif err := d.Store.Save(ctx, run); err != nil {\n\t\td.log().Error(\"save run failed\", \"ticket\", run.Ticket, \"err\", err)\n\t}\n}\n\nfunc (d *Dispatcher) event(ctx context.Context, run *state.Run, ev, msg string) {\n\te := state.LogEntry{Time: d.now(), Agent: d.Cfg.AgentID, Event: ev, Phase: string(run.Phase), Cause: run.StopCause, Message: msg}\n\tif err := d.Store.AppendLog(ctx, run.Ticket, e); err != nil {\n\t\td.log().Error(\"append log failed\", \"ticket\", run.Ticket, \"err\", err)\n\t}\n}\n","numLines":293,"startLine":1,"totalLines":293}}}
