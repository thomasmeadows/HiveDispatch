urn fail(executor.CauseStepBudget, text)\n60\t\tcase errors.Is(exit.CtxErr, context.Canceled):\n61\t\t\treturn fail(executor.CauseKilled, text)\n62\t\tcase tr.Result == nil:\n63\t\t\tsummary := \"executor exited without a result\"\n64\t\t\tif exit.ExitErr != nil {\n65\t\t\t\tsummary += \": \" + exit.ExitErr.Error()\n66\t\t\t}\n67\t\t\tif s := strings.TrimSpace(exit.Stderr); s != \"\" {\n68\t\t\t\tsummary += \"\\n\" + truncate(s, 1000)\n69\t\t\t}\n70\t\t\treturn fail(executor.CauseError, summary)\n71\t\tcase tr.Result.IsError:\n72\t\t\tif budget, reset := claudecli.LooksLikeBudget(tr); budget {\n73\t\t\t\tif !reset.IsZero() {\n74\t\t\t\t\ttext += \"\\n\\nQuota resets at \" + reset.UTC().Format(\"2006-01-02 15:04 UTC\") + \".\"\n75\t\t\t\t\tres.RetryAfter = reset\n76\t\t\t\t}\n77\t\t\t\treturn fail(executor.CauseBudget, text)\n78\t\t\t}\n79\t\t\treturn fail(executor.CauseError, text)\n80\t\t}\n81\t\tif q, ok := parseNeedsInput(text); ok {\n82\t\t\tres.Status = executor.StatusNeedsInput\n83\t\t\tres.Question = q\n84\t\t\tres.Summary = truncate(text, maxSummary)\n85\t\t\treturn res\n86\t\t}\n87\t\tres.Status = executor.StatusCompleted\n88\t\tif text == \"\" {\n89\t\t\ttext = \"Run completed.\"\n90\t\t}\n91\t\tres.Summary = truncate(text, maxSummary)\n92\t\treturn res\n93\t}\n94\t"}]},"parent_tool_use_id":null,"session_id":"cb7de223-5e43-4120-ae08-3d4a6a3cb28c","uuid":"29219e06-6767-4442-8279-3b2bbdbf0458","timestamp":"2026-09-20T07:07:45.823Z","tool_use_result":{"type":"text","file":{"filePath":"/home/thomas/.local/share/hivedispatch/repos/thomasmeadows__HiveDispatch/GITHUB-8/internal/executor/claudecode/outcome.go","content":"package claudecode\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"strings\"\n\n\t\"github.com/thomasmeadows/hivedispatch/internal/claudecli\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/executor\"\n\t\"github.com/thomasmeadows/hivedispatch/internal/prompt\"\n)\n\nconst maxSummary = 4000\n\n// parseNeedsInput finds the last HIVE_NEEDS_INPUT: