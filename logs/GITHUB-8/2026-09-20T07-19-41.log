odel, cfg.Model); model != \"\" {\n\t\targs = append(args, \"--model\", model)\n\t}\n\treturn args\n}\n\nfunc firstNonEmpty(a, b string) string {\n\tif a != \"\" {\n\t\treturn a\n\t}\n\treturn b\n}\n","numLines":53,"startLine":1,"totalLines":53}}}
