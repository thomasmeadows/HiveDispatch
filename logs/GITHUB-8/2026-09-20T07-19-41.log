{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013p3Rv32rba8QCaWhYQrzAT","type":"tool_result","content":"1\t// Package repoconfig reads .hivedispatch.yaml from a governed repository.\n2\t// Per-repo policy lives in the repo so changes go through the same review\n3\t// as code.\n4\tpackage repoconfig\n5\t\n6\timport (\n7\t\t\"errors\"\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t\n13\t\t\"gopkg.in/yaml.v3\"\n14\t)\n15\t\n16\t// FileName is the config file at the repo root.\n17\tconst FileName = \".hivedispatch.yaml\"\n18\t\n19\t// Config is the per-repo policy.\n20\ttype Config struct {\n21\t\tExecutor ExecutorConfig `yaml:\"executor\"`\n22\t\tGuidance string         `yaml:\"guidance\"`\n23\t}\n24\t\n25\t// ExecutorConfig controls how the coding agent is invoked.\n26\ttype ExecutorConfig struct {\n27\t\tModel          string   `yaml:\"model\"`\n28\t\tPermissionMode string   `yaml:\"permission_mode\"`\n29\t\tTools          []string `yaml:\"tools\"`\n30\t\tAllowedTools   []string `yaml:\"allowed_tools\"`\n31\t\tMaxBudgetUSD   float64  `yaml:\"max_budget_usd\"`\n32\t\t// Path lists directories prepended to PATH for the agent, so tools the\n33\t\t// policy allows by name (e.g. golangci-lint) resolve. ~ and $VAR expand.\n34\t\tPath []string `yaml:\"path\"`\n35\t}\n36\t\n37\t// ExtraPath returns Path with ~ and environment variables expanded.\n38\tfunc (e ExecutorConfig) ExtraPath() []string {\n39\t\tvar out []string\n40\t\thome, _ := os.UserHomeDir()\n41\t\tfor _, p := range e.Path {\n42\t\t\tp = os.ExpandEnv(p)\n43\t\t\tif p == \"~\" || strings.HasPrefix(p, \"~/\") {\n44\t\t\t\tp = filepath.Join(home, strings.TrimPrefix(p, \"~\"))\n45\t\t\t}\n46\t\t\tif p != \"\" {\n47\t\t\t\tout = append(out, p)\n48\t\t\t}\n49\t\t}\n50\t\treturn out\n51\t}\n52\t\n53\tvar permissionModes = map[string]bool{\"acceptEdits\": true, \"auto\": true, \"bypassPermissions\": true, \"manual\": true, \"dontAsk\": true, \"plan\": true}\n54\t\n55\t// Load reads dir/.hivedispatch.yaml; a missing file yields defaults.\n56\tfunc Load(dir string) (Config, error) {\n57\t\tvar c Config\n58\t\traw, err := os.ReadFile(filepath.Join(dir, FileName))\n59\t\tif err != nil && !errors.Is(err, os.ErrNotExist) {\n60\t\t\treturn c, err\n61\t\t}\n62\t\tif err == nil {\n63\t\t\tif err := yaml.Unmarshal(raw, &c); err != nil {\n64\t\t\t\treturn c, fmt.Errorf(\"%s: %w\", FileName, err)\n65\t\t\t}\n66\t\t}\n67\t\tif c.Executor.PermissionMode == \"\" {\n68\t\t\tc.Executor.PermissionMode = \"dontAsk\"\n69\t\t}\n70\t\tif len(c.Executor.Tools) == 0 {\n71\t\t\tc.Executor.Tools = []string{\"default\"}\n72\t\t}\n73\t\tif !permissionModes[c.Executor.PermissionMode] {\n74\t\t\treturn c, fmt.Errorf(\"%s: executor.permission_mode %q is not a Claude Code permission mode\", FileName, c.Executor.PermissionMode)\n75\t\t}\n76\t\treturn c, nil\n77\t}\n78\t"}]},"parent_tool_use_id":null,"session_id":"cb7de223-5e43-4120-ae08-3d4a6a3cb28c","uuid":"3a9751fd-b276-4d62-a68f-ace22198d76a","timestamp":"2026-09-20T07:07:58.773Z","tool_use_result":{"type":"text","file":{"filePath":"/home/thomas/.local/share/hivedispatch/repos/thomasmeadows__HiveDispatch/GITHUB-8/internal/repoconfig/repoconfig.go","content":"// Package repoconfig reads .hivedispatch.yaml from a governed repository.\n// Per-repo policy lives in the repo so changes go through the same review\n// as code.\npackage repoconfig\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// FileName is the config file at the repo root.\nconst FileName = \".hivedispatch.yaml\"\n\n// Config is the per-repo policy.\ntype Config struct {\n\tExecutor ExecutorConfig `yaml:\"executor\"`\n\tGuidance string         `yaml:\"guidance\"`\n}\n\n// ExecutorConfig controls how the coding agent is invoked.\ntype ExecutorConfig struct {\n\tModel          string   `yaml:\"model\"`\n\tPermissionMode string   `yaml:\"permission_mode\"`\n\tTools          []string `yaml:\"tools\"`\n\tAllowedTools   []string `yaml:\"allowed_tools\"`\n\tMaxBudgetUSD   float64  `yaml:\"max_budget_usd\"`\n\t// Path lists directories prepended to PATH for the agent, so tools the\n\t// policy allows by name (e.g. golangci-lint) resolve. ~ and $VAR expand.\n\tPath []string `yaml:\"path\"`\n}\n\n// ExtraPath returns Path with ~ and environment variables expanded.\nfunc (e ExecutorConfig) ExtraPath() []string {\n\tvar out []string\n\thome, _ := os.UserHomeDir()\n\tfor _, p := range e.Path {\n\t\tp = os.ExpandEnv(p)\n\t\tif p == \"~\" || strings.HasPrefix(p, \"~/\") {\n\t\t\tp = filepath.Join(home, strings.TrimPrefix(p, \"~\"))\n\t\t}\n\t\tif p != \"\" {\n\t\t\tout = append(out, p)\n\t\t}\n\t}\n\treturn out\n}\n\nvar permissionModes = map[string]bool{\"acceptEdits\": true, \"auto\": true, \"bypassPermissions\": true, \"manual\": true, \"dontAsk\": true, \"plan\": true}\n\n// Load reads dir/.hivedispatch.yaml; a missing file yields defaults.\nfunc Load(dir string) (Config, error) {\n\tvar c Config\n\traw, err := os.ReadFile(filepath.Join(dir, FileName))\n\tif err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\treturn c, err\n\t}\n\tif err == nil {\n\t\tif err := yaml.Unmarshal(raw, &c); err != nil {\n\t\t\treturn c, fmt.Errorf(\"%s: %w\", FileName, err)\n\t\t}\n\t}\n\tif c.Executor.PermissionMode == \"\" {\n\t\tc.Executor.PermissionMode = \"dontAsk\"\n\t}\n\tif len(c.Executor.Tools) == 0 {\n\t\tc.Executor.Tools = []string{\"default\"}\n\t}\n\tif !permissionModes[c.Executor.PermissionMode] {\n\t\treturn c, fmt.Errorf(\"%s: executor.permission_mode %q is not a Claude Code permission mode\", FileName, c.Executor.PermissionMode)\n\t}\n\treturn c, nil\n}\n","numLines":78,"startLine":1,"totalLines":78}}}
