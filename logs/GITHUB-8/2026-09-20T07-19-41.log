{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FHbRV61t1Ygjtd77ePKJu9","type":"tool_result","content":"1\t// Package executor defines the boundary between the orchestrator and a\n2\t// coding-agent CLI.\n3\t//\n4\t// The orchestrator guarantees the adapter a prepared workspace, a rendered\n5\t// prompt, and bounded resources. The adapter guarantees back a terminal\n6\t// status and a human-readable summary, always — even on failure.\n7\tpackage executor\n8\t\n9\timport (\n10\t\t\"context\"\n11\t\t\"time\"\n12\t)\n13\t\n14\t// Status is the terminal status of a run.\n15\ttype Status string\n16\t\n17\t// Terminal statuses.\n18\tconst (\n19\t\tStatusCompleted  Status = \"completed\"\n20\t\tStatusNeedsInput Status = \"needs_input\"\n21\t\tStatusFailed     Status = \"failed\"\n22\t)\n23\t\n24\t// Cause records why a run stopped.\n25\ttype Cause string\n26\t\n27\t// Stop causes. CauseNone means the run reached its own conclusion.\n28\tconst (\n29\t\tCauseNone       Cause = \"\"\n30\t\tCauseBudget     Cause = \"budget\"\n31\t\tCauseTimeout    Cause = \"timeout\"\n32\t\tCauseStepBudget Cause = \"step_budget\"\n33\t\tCauseOverlap    Cause = \"overlap\"\n34\t\tCauseError      Cause = \"error\"\n35\t\tCauseKilled     Cause = \"killed\"\n36\t)\n37\t\n38\t// Describe returns a short human explanation for ticket comments.\n39\tfunc (c Cause) Describe() string {\n40\t\tswitch c {\n41\t\tcase CauseBudget:\n42\t\t\treturn \"provider budget or rate limit reached\"\n43\t\tcase CauseTimeout:\n44\t\t\treturn \"wall-clock timeout reached\"\n45\t\tcase CauseStepBudget:\n46\t\t\treturn \"step budget exhausted (the ticket may be underspecified)\"\n47\t\tcase CauseOverlap:\n48\t\t\treturn \"file overlap with another in-flight ticket\"\n49\t\tcase CauseError:\n50\t\t\treturn \"the executor reported an error\"\n51\t\tcase CauseKilled:\n52\t\t\treturn \"the run was interrupted\"\n53\t\t}\n54\t\treturn \"\"\n55\t}\n56\t\n57\t// Task is one unit of work handed to an executor.\n58\ttype Task struct {\n59\t\tTicketKey   string\n60\t\tPrompt      string // ticket body + comment thread, rendered\n61\t\tWorkspace   string // path to the prepared worktree\n62\t\tResumeToken string // opaque; stored, never interpreted\n63\t\tStepBudget  int\n64\t}\n65\t\n66\t// Footprint is the set of files a planned run expects to touch.\n67\ttype Footprint struct {\n68\t\tFiles []string\n69\t}\n70\t\n71\t// Result is what an executor returns. Status is always set.\n72\ttype Result struct {\n73\t\tStatus       Status\n74\t\tStopCause    Cause\n75\t\tSummary      string // posted to the ticket\n76\t\tQuestion     string // when NeedsInput\n77\t\tResumeToken  string // opaque; persisted for the next run\n78\t\tChangedFiles []string\n79\t\tLog          string\n80\t\t// RetryAfter is when a Budget stop is expected to clear; zero if unknown.\n81\t\tRetryAfter time.Time\n82\t}\n83\t\n84\t// Executor wraps one coding-agent CLI. Timeouts ride on the context.\n85\ttype Executor interface {\n86\t\tName() string\n87\t\tPlan(ctx context.Context, t Task) (Footprint, error)\n88\t\tRun(ctx context.Context, t Task) (Result, error)\n89\t}\n90\t"}]},"parent_tool_use_id":null,"session_id":"cb7de223-5e43-4120-ae08-3d4a6a3cb28c","uuid":"0d218c23-97df-4161-b371-bdeaa18e6e07","timestamp":"2026-09-20T07:07:43.471Z","tool_use_result":{"type":"text","file":{"filePath":"/home/thomas/.local/share/hivedispatch/repos/thomasmeadows__HiveDispatch/GITHUB-8/internal/executor/executor.go","content":"// Package executor defines the boundary between the orchestrator and a\n// coding-agent CLI.\n//\n// The orchestrator guarantees the adapter a prepared workspace, a rendered\n// prompt, and bounded resources. The adapter guarantees back a terminal\n// status and a human-readable summary, always — even on failure.\npackage executor\n\nimport (\n\t\"context\"\n\t\"time\"\n)\n\n// Status is the terminal status of a run.\ntype Status string\n\n// Terminal statuses.\nconst (\n\tStatusCompleted  Status = \"completed\"\n\tStatusNeedsInput Status = \"needs_input\"\n\tStatusFailed     Status = \"failed\"\n)\n\n// Cause records why a run stopped.\ntype Cause string\n\n// Stop causes. CauseNone means the run reached its own conclusion.\nconst (\n\tCauseNone       Cause = \"\"\n\tCauseBudget     Cause = \"budget\"\n\tCauseTimeout    Cause = \"timeout\"\n\tCauseStepBudget Cause = \"step_budget\"\n\tCauseOverlap    Cause = \"overlap\"\n\tCauseError      Cause = \"error\"\n\tCauseKilled     Cause = \"killed\"\n)\n\n// Describe returns a short human explanation for ticket comments.\nfunc (c Cause) Describe() string {\n\tswitch c {\n\tcase CauseBudget:\n\t\treturn \"provider budget or rate limit reached\"\n\tcase CauseTimeout:\n\t\treturn \"wall-clock timeout reached\"\n\tcase CauseStepBudget:\n\t\treturn \"step budget exhausted (the ticket may be underspecified)\"\n\tcase CauseOverlap:\n\t\treturn \"file overlap with another in-flight ticket\"\n\tcase CauseError:\n\t\treturn \"the executor reported an error\"\n\tcase CauseKilled:\n\t\treturn \"the run was interrupted\"\n\t}\n\treturn \"\"\n}\n\n// Task is one unit of work handed to an executor.\ntype Task struct {\n\tTicketKey   string\n\tPrompt      string // ticket body + comment thread, rendered\n\tWorkspace   string // path to the prepared worktree\n\tResumeToken string // opaque; stored, never interpreted\n\tStepBudget  int\n}\n\n// Footprint is the set of files a planned run expects to touch.\ntype Footprint struct {\n\tFiles []string\n}\n\n// Result is what an executor returns. Status is always set.\ntype Result struct {\n\tStatus       Status\n\tStopCause    Cause\n\tSummary      string // posted to the ticket\n\tQuestion     string // when NeedsInput\n\tResumeToken  string // opaque; persisted for the next run\n\tChangedFiles []string\n\tLog          string\n\t// RetryAfter is when a Budget stop is expected to clear; zero if unknown.\n\tRetryAfter time.Time\n}\n\n// Executor wraps one coding-agent CLI. Timeouts ride on the context.\ntype Executor interface {\n\tName() string\n\tPlan(ctx context.Context, t Task) (Footprint, error)\n\tRun(ctx context.Context, t Task) (Result, error)\n}\n","numLines":90,"startLine":1,"totalLines":90}}}
