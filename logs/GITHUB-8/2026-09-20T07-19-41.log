est.Setup(t, \"crash\")\n52\t\ttr, exit, _, err := Run(context.Background(), Cmd{Binary: bin, Dir: t.TempDir()})\n53\t\tif err != nil || exit.ExitErr == nil || tr.Result != nil || !strings.Contains(exit.Stderr, \"segfault\") {\n54\t\t\tt.Errorf(\"tr=%+v exit=%+v err=%v\", tr, exit, err)\n55\t\t}\n56\t}\n57\t"}]},"parent_tool_use_id":null,"session_id":"cb7de223-5e43-4120-ae08-3d4a6a3cb28c","uuid":"f878a4a7-b859-4d3a-b4de-c90dae2c0df7","timestamp":"2026-09-20T07:07:49.918Z","tool_use_result":{"type":"text","file":{"filePath":"/home/thomas/.local/share/hivedispatch/repos/thomasmeadows__HiveDispatch/GITHUB-8/internal/claudecli/run_test.go","content":"package claudecli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/thomasmeadows/hivedispatch/internal/claudecli/clitest\"\n)\n\nfunc TestRunSuccessCapturesTranscriptAndLog(t *testing.T) {\n\tbin, _, stdinFile := clitest.Setup(t, \"success\")\n\ttr, exit, log, err := Run(context.Background(), Cmd{Binary: bin, Dir: t.TempDir(), Stdin: \"hi\", StepBudget: 10})\n\tif err != nil || exit.ExitErr != nil || tr.Result == nil || tr.Result.Result != \"hello\" {\n\t\tt.Fatalf(\"tr=%+v exit=%+v err=%v\", tr, exit, err)\n\t}\n\tif !strings.Contains(log, `\"type\": \"result\"`) {\n\t\tt.Error(\"log missing stream\")\n\t}\n\tif b, _ := os.ReadFile(stdinFile); string(b) != \"hi\" {\n\t\tt.Errorf(\"stdin = %q\", b)\n\t}\n}\n\nfunc TestRunTimeoutKillsGroup(t *testing.T) {\n\tbin, _, _ := clitest.Setup(t, \"hang\")\n\tctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)\n\tdefer cancel()\n\tstart := time.Now()\n\ttr, exit, _, err := Run(ctx, Cmd{Binary: bin, Dir: t.TempDir()})\n\tif err != nil || !errors.Is(exit.CtxErr, context.DeadlineExceeded) || tr.SessionID == \"\" {\n\t\tt.Errorf(\"tr=%+v exit=%+v err=%v\", tr, exit, err)\n\t}\n\tif time.Since(start) > 3*time.Second {\n\t\tt.Error(\"not killed promptly\")\n\t}\n}\n\nfunc TestRunStepBudgetTrips(t *test