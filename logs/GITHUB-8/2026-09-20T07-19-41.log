{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013pCKbTibvtQJM4i2D3oHRM","type":"tool_result","content":"1\t// Package claudecli runs the Claude Code CLI headless and parses its\n2\t// stream-json output. Both the executor and the triager build on it, so\n3\t// process supervision (process-group kill, step budget, timeout, bounded\n4\t// logs) lives in one place.\n5\tpackage claudecli\n6\t\n7\timport (\n8\t\t\"encoding/json\"\n9\t\t\"path/filepath\"\n10\t\t\"strings\"\n11\t\t\"time\"\n12\t)\n13\t\n14\t// BudgetError reports that the provider refused work for quota reasons.\n15\t// ResetsAt is zero when the reset time is unknown.\n16\ttype BudgetError struct {\n17\t\tMessage  string\n18\t\tResetsAt time.Time\n19\t}\n20\t\n21\tfunc (e *BudgetError) Error() string {\n22\t\tif e.ResetsAt.IsZero() {\n23\t\t\treturn \"budget: \" + e.Message\n24\t\t}\n25\t\treturn \"budget: \" + e.Message + \" (resets \" + e.ResetsAt.UTC().Format(\"2006-01-02 15:04 UTC\") + \")\"\n26\t}\n27\t\n28\t// LooksLikeBudget reports whether a finished transcript indicates a quota\n29\t// or rate-limit stop, and the reset time if the stream carried one.\n30\tfunc LooksLikeBudget(tr Transcript) (bool, time.Time) {\n31\t\tvar reset time.Time\n32\t\tif tr.RateLimit != nil && !tr.RateLimit.ResetsAt.IsZero() {\n33\t\t\treset = tr.RateLimit.ResetsAt\n34\t\t}\n35\t\tr := tr.Result\n36\t\tif r != nil && r.APIErrorStatus != nil && *r.APIErrorStatus == 429 {\n37\t\t\treturn true, reset\n38\t\t}\n39\t\tif tr.RateLimit != nil && tr.RateLimit.Status != \"\" && tr.RateLimit.Status != \"allowed\" {\n40\t\t\treturn true, reset\n41\t\t}\n42\t\tif r != nil {\n43\t\t\tlow := strings.ToLower(r.Result)\n44\t\t\tif strings.Contains(low, \"usage limit\") || strings.Contains(low, \"rate limit\") || strings.Contains(low, \"session limit\") {\n45\t\t\t\treturn true, reset\n46\t\t\t}\n47\t\t}\n48\t\treturn false, reset\n49\t}\n50\t\n51\t// RateLimit is the last rate_limit_event seen on the stream.\n52\ttype RateLimit struct {\n53\t\tStatus   string\n54\t\tResetsAt time.Time\n55\t}\n56\t\n57\t// ResultMsg is the final \"result\" message of a headless run.\n58\ttype ResultMsg struct {\n59\t\tSubtype          string          `json:\"subtype\"`\n60\t\tIsError          bool            `json:\"is_error\"`\n61\t\tResult           string          `json:\"result\"`\n62\t\tSessionID        string          `json:\"session_id\"`\n63\t\tNumTurns         int             `json:\"num_turns\"`\n64\t\tStopReason       string          `json:\"stop_reason\"`\n65\t\tTerminalReason   string          `json:\"terminal_reason\"`\n66\t\tAPIErrorStatus   *int            `json:\"api_error_status\"`\n67\t\tStructuredOutput json.RawMessage `json:\"structured_output\"`\n68\t\tTotalCostUSD     float64         `json:\"total_cost_usd\"`\n69\t}\n70\t\n71\t// Transcript is what the parser learned from a run.\n72\ttype Transcript struct {\n73\t\tSessionID   string\n74\t\tToolUses    int\n75\t\tEditedFiles []string\n76\t\tRateLimit   *RateLimit\n77\t\tResult      *ResultMsg\n78\t\tLines       int\n79\t}\n80\t\n81\t// Parser consumes stream-json lines and accumulates a Transcript.\n82\ttype Parser struct {\n83\t\tcwd       string // the workspace we ran in\n84\t\tinitCwd   string // what the CLI reported in its init event\n85\t\tonToolUse func(count int)\n86\t\tt         Transcript\n87\t\tedited    map[string]bool\n88\t}\n89\t\n90\t// NewParser returns a parser that relativises edited paths against cwd and\n91\t// calls onToolUse with the running count after every tool call.\n92\tfunc NewParser(cwd string, onToolUse func(int)) *Parser {\n93\t\treturn &Parser{cwd: cwd, onToolUse: onToolUse, edited: map[string]bool{}}\n94\t}\n95\t\n96\t// editingTools are the built-in tools whose input names a file they change.\n97\tvar editingTools = map[string]string{\n98\t\t\"Edit\": \"file_path\", \"Write\": \"file_path\", \"MultiEdit\": \"file_path\", \"NotebookEdit\": \"notebook_path\",\n99\t}\n100\t\n101\ttype envelope struct {\n102\t\tType      string `json:\"type\"`\n103\t\tSubtype   string `json:\"subtype\"`\n104\t\tSessionID string `json:\"session_id\"`\n105\t\tCwd       string `json:\"cwd\"`\n106\t\tMessage   *struct {\n107\t\t\tContent json.RawMessage `json:\"content\"`\n108\t\t} `json:\"message\"`\n109\t\tRateLimitInfo *struct {\n110\t\t\tStatus   string `json:\"status\"`\n111\t\t\tResetsAt int64  `json:\"resetsAt\"`\n112\t\t} `json:\"rate_limit_info\"`\n113\t}\n114\t\n115\ttype contentBlock struct {\n116\t\tType  string                     `json:\"type\"`\n117\t\tName  string                     `json:\"name\"`\n118\t\tInput map[string]json.RawMessage `json:\"input\"`\n119\t}\n120\t\n121\t// Line consumes one line of output. Non-JSON lines are counted and ignored.\n122\tfunc (p *Parser) Line(raw []byte) {\n123\t\tp.t.Lines++\n124\t\traw = []byte(strings.TrimSpace(string(raw)))\n125\t\tif len(raw) == 0 || raw[0] != '{' {\n126\t\t\treturn\n127\t\t}\n128\t\tvar env envelope\n129\t\tif json.Unmarshal(raw, &env) != nil {\n130\t\t\treturn\n131\t\t}\n132\t\tswitch env.Type {\n133\t\tcase \"system\":\n134\t\t\tif env.Subtype == \"init\" {\n135\t\t\t\tif env.SessionID != \"\" {\n136\t\t\t\t\tp.t.SessionID = env.SessionID\n137\t\t\t\t}\n138\t\t\t\tp.initCwd = env.Cwd\n139\t\t\t}\n140\t\tcase \"assistant\":\n141\t\t\tif env.Message == nil {\n142\t\t\t\treturn\n143\t\t\t}\n144\t\t\tvar blocks []contentBlock\n145\t\t\tif json.Unmarshal(env.Message.Content, &blocks) != nil {\n146\t\t\t\treturn\n147\t\t\t}\n148\t\t\tfor _, b := range blocks {\n149\t\t\t\tif b.Type != \"tool_use\" {\n150\t\t\t\t\tcontinue\n151\t\t\t\t}\n152\t\t\t\tp.t.ToolUses++\n153\t\t\t\tif field, ok := editingTools[b.Name]; ok {\n154\t\t\t\t\tvar path string\n155\t\t\t\t\tif json.Unmarshal(b.Input[field], &path) == nil && path != \"\" {\n156\t\t\t\t\t\tp.addEdited(path)\n157\t\t\t\t\t}\n158\t\t\t\t}\n159\t\t\t\tif p.onToolUse != nil {\n160\t\t\t\t\tp.onToolUse(p.t.ToolUses)\n161\t\t\t\t}\n162\t\t\t}\n163\t\tcase \"rate_limit_event\":\n164\t\t\tif env.RateLimitInfo != nil {\n165\t\t\t\tp.t.RateLimit = &RateLimit{Status: env.RateLimitInfo.Status, ResetsAt: time.Unix(env.RateLimitInfo.ResetsAt, 0)}\n166\t\t\t}\n167\t\tcase \"result\":\n168\t\t\tvar r ResultMsg\n169\t\t\tif json.Unmarshal(raw, &r) == nil {\n170\t\t\t\tp.t.Result = &r\n171\t\t\t\tif r.SessionID != \"\" {\n172\t\t\t\t\tp.t.SessionID = r.SessionID\n173\t\t\t\t}\n174\t\t\t}\n175\t\t}\n176\t}\n177\t\n178\tfunc (p *Parser) addEdited(path string) {\n179\t\tfor _, base := range []string{p.cwd, p.initCwd} {\n180\t\t\tif base == \"\" {\n181\t\t\t\tcontinue\n182\t\t\t}\n183\t\t\tif rel, err := filepath.Rel(base, path); err == nil && !strings.HasPrefix(rel, \"..\") && !filepath.IsAbs(rel) {\n184\t\t\t\tpath = rel\n185\t\t\t\tbreak\n186\t\t\t}\n187\t\t}\n188\t\tif !p.edited[path] {\n189\t\t\tp.edited[path] = true\n190\t\t\tp.t.EditedFiles = append(p.t.EditedFiles, path)\n191\t\t}\n192\t}\n193\t\n194\t// Transcript returns what has been parsed so far.\n195\tfunc (p *Parser) Transcript() Transcript {\n196\t\treturn p.t\n197\t}\n198\t"}]},"parent_tool_use_id":null,"session_id":"cb7de223-5e43-4120-ae08-3d4a6a3cb28c","uuid":"5c4a52cb-ad25-4ec0-85f3-4f1f80e2fd2d","timestamp":"2026-09-20T07:07:49.231Z","tool_use_result":{"type":"text","file":{"filePath":"/home/thomas/.local/share/hivedispatch/repos/thomasmeadows__HiveDispatch/GITHUB-8/internal/claudecli/stream.go","content":"// Package claudecli runs the Claude Code CLI headless and parses its\n// stream-json output. Both the executor and the triager build on it, so\n// process supervision (process-group kill, step budget, timeout, bounded\n// logs) lives in one place.\npackage claudecli\n\nimport (\n\t\"encoding/json\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n)\n\n// BudgetError reports that the provider refused work for quota reasons.\n// ResetsAt is zero when the reset time is unknown.\ntype BudgetError struct {\n\tMessage  string\n\tResetsAt time.Time\n}\n\nfunc (e *BudgetError) Error() string {\n\tif e.ResetsAt.IsZero() {\n\t\treturn \"budget: \" + e.Message\n\t}\n\treturn \"budget: \" + e.Message + \" (resets \" + e.ResetsAt.UTC().Format(\"2006-01-02 15:04 UTC\") + \")\"\n}\n\n// LooksLikeBudget reports whether a finished transcript indicates a quota\n// or rate-limit stop, and the reset time if the stream carried one.\nfunc LooksLikeBudget(tr Transcript) (bool, time.Time) {\n\tvar reset time.Time\n\tif tr.RateLimit != nil && !tr.RateLimit.ResetsAt.IsZero() {\n\t\treset = tr.RateLimit.ResetsAt\n\t}\n\tr := tr.Result\n\tif r != nil && r.APIErrorStatus != nil && *r.APIErrorStatus == 429 {\n\t\treturn true, reset\n\t}\n\tif tr.RateLimit != nil && tr.RateLimit.Status != \"\" && tr.RateLimit.Status != \"allowed\" {\n\t\treturn true, reset\n\t}\n\tif r != nil {\n\t\tlow := strings.ToLower(r.Result)\n\t\tif strings.Contains(low, \"usage limit\") || strings.Contains(low, \"rate limit\") || strings.Contains(low, \"session limit\") {\n\t\t\treturn true, reset\n\t\t}\n\t}\n\treturn false, reset\n}\n\n// RateLimit is the last rate_limit_event seen on the stream.\ntype RateLimit struct {\n\tStatus   string\n\tResetsAt time.Time\n}\n\n// ResultMsg is the final \"result\" message of a headless run.\ntype ResultMsg struct {\n\tSubtype          string          `json:\"subtype\"`\n\tIsError          bool            `json:\"is_error\"`\n\tResult           string          `json:\"result\"`\n\tSessionID        string          `json:\"session_id\"`\n\tNumTurns         int             `json:\"num_turns\"`\n\tStopReason       string          `json:\"stop_reason\"`\n\tTerminalReason   string          `json:\"terminal_reason\"`\n\tAPIErrorStatus   *int            `json:\"api_error_status\"`\n\tStructuredOutput json.RawMessage `json:\"structured_output\"`\n\tTotalCostUSD     float64         `json:\"total_cost_usd\"`\n}\n\n// Transcript is what the parser learned from a run.\ntype Transcript struct {\n\tSessionID   string\n\tToolUses    int\n\tEditedFiles []string\n\tRateLimit   *RateLimit\n\tResult      *ResultMsg\n\tLines       int\n}\n\n// Parser consumes stream-json lines and accumulates a Transcript.\ntype Parser struct {\n\tcwd       string // the workspace we ran in\n\tinitCwd   string // what the CLI reported in its init event\n\tonToolUse func(count int)\n\tt         Transcript\n\tedited    map[string]bool\n}\n\n// NewParser returns a parser that relativises edited paths against cwd and\n// calls onToolUse with the running count after every tool call.\nfunc NewParser(cwd string, onToolUse func(int)) *Parser {\n\treturn &Parser{cwd: cwd, onToolUse: onToolUse, edited: map[string]bool{}}\n}\n\n// editingTools are the built-in tools whose input names a file they change.\nvar editingTools = map[string]string{\n\t\"Edit\": \"file_path\", \"Write\": \"file_path\", \"MultiEdit\": \"file_path\", \"NotebookEdit\": \"notebook_path\",\n}\n\ntype envelope struct {\n\tType      string `json:\"type\"`\n\tSubtype   string `json:\"subtype\"`\n\tSessionID string `json:\"session_id\"`\n\tCwd       string `json:\"cwd\"`\n\tMessage   *struct {\n\t\tContent json.RawMessage `json:\"content\"`\n\t} `json:\"message\"`\n\tRateLimitInfo *struct {\n\t\tStatus   string `json:\"status\"`\n\t\tResetsAt int64  `json:\"resetsAt\"`\n\t} `json:\"rate_limit_info\"`\n}\n\ntype contentBlock struct {\n\tType  string                     `json:\"type\"`\n\tName  string                     `json:\"name\"`\n\tInput map[string]json.RawMessage `json:\"input\"`\n}\n\n// Line consumes one line of output. Non-JSON lines are counted and ignored.\nfunc (p *Parser) Line(raw []byte) {\n\tp.t.Lines++\n\traw = []byte(strings.TrimSpace(string(raw)))\n\tif len(raw) == 0 || raw[0] != '{' {\n\t\treturn\n\t}\n\tvar env envelope\n\tif json.Unmarshal(raw, &env) != nil {\n\t\treturn\n\t}\n\tswitch env.Type {\n\tcase \"system\":\n\t\tif env.Subtype == \"init\" {\n\t\t\tif env.SessionID != \"\" {\n\t\t\t\tp.t.SessionID = env.SessionID\n\t\t\t}\n\t\t\tp.initCwd = env.Cwd\n\t\t}\n\tcase \"assistant\":\n\t\tif env.Message == nil {\n\t\t\treturn\n\t\t}\n\t\tvar blocks []contentBlock\n\t\tif json.Unmarshal(env.Message.Content, &blocks) != nil {\n\t\t\treturn\n\t\t}\n\t\tfor _, b := range blocks {\n\t\t\tif b.Type != \"tool_use\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tp.t.ToolUses++\n\t\t\tif field, ok := editingTools[b.Name]; ok {\n\t\t\t\tvar path string\n\t\t\t\tif json.Unmarshal(b.Input[field], &path) == nil && path != \"\" {\n\t\t\t\t\tp.addEdited(path)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif p.onToolUse != nil {\n\t\t\t\tp.onToolUse(p.t.ToolUses)\n\t\t\t}\n\t\t}\n\tcase \"rate_limit_event\":\n\t\tif env.RateLimitInfo != nil {\n\t\t\tp.t.RateLimit = &RateLimit{Status: env.RateLimitInfo.Status, ResetsAt: time.Unix(env.RateLimitInfo.ResetsAt, 0)}\n\t\t}\n\tcase \"result\":\n\t\tvar r ResultMsg\n\t\tif json.Unmarshal(raw, &r) == nil {\n\t\t\tp.t.Result = &r\n\t\t\tif r.SessionID != \"\" {\n\t\t\t\tp.t.SessionID = r.SessionID\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc (p *Parser) addEdited(path string) {\n\tfor _, base := range []string{p.cwd, p.initCwd} {\n\t\tif base == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif rel, err := filepath.Rel(base, path); err == nil && !strings.HasPrefix(rel, \"..\") && !filepath.IsAbs(rel) {\n\t\t\tpath = rel\n\t\t\tbreak\n\t\t}\n\t}\n\tif !p.edited[path] {\n\t\tp.edited[path] = true\n\t\tp.t.EditedFiles = append(p.t.EditedFiles, path)\n\t}\n}\n\n// Transcript returns what has been parsed so far.\nfunc (p *Parser) Transcript() Transcript {\n\treturn p.t\n}\n","numLines":198,"startLine":1,"totalLines":198}}}
