{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PX88NdHqYVE8viSBCWQqKU","type":"tool_result","content":"100\t  #   needs_human: Needs Human\n101\t\n102\trepos:\n103\t    # owner/repo as shown on GitHub (used for the pull-request API).\n104\t  - name: yourorg/yourrepo\n105\t    # Clone URL your own git credentials can push to (ssh key or credential helper).\n106\t    url: git@github.com:yourorg/yourrepo.git\n107\t    # Ticket key prefix for this repo. Jira: the project key (SCRUM for SCRUM-4).\n108\t    # GitHub Issues: any short upper-case tag you choose; issue #12 becomes KEY-12.\n109\t    project: KEY\n110\t    # default_branch: main\n111\t\n112\t# Optional. Defaults shown.\n113\t# poll_interval: 60s\n114\t# heartbeat_interval: 60s\n115\t# claim_timeout: 2h        # a claim older than this is considered abandoned\n116\t# run_timeout: 45m\n117\t# step_budget: 200         # tool calls per run\n118\t# max_attempts: 3\n119\t# executor: claude         # or fake (no agent; useful for trying the pipeline)\n120\t# state_store: branch      # or local\n121\t# triage:\n122\t#   kind: claude           # or passthrough\n123\t#   step_budget: 40\n124\t#   timeout: 5m\n125\t# run_windows:             # only start new work inside these windows\n126\t#   timezone: America/New_York\n127\t#   windows:\n128\t#     - days: [mon, tue, wed, thu, fri]\n129\t#       start: \"22:00\"\n130\t#       end: \"06:00\"\n131\t`\n132\t\n133\t// WriteStarter writes Starter to path unless a non-empty file already exists\n134\t// there. It returns true when a file was written.\n135\tfunc WriteStarter(path string) (bool, error) {\n136\t\tif fi, err := os.Stat(path); err == nil {\n137\t\t\tif fi.Size() > 0 {\n138\t\t\t\treturn false, nil\n139\t\t\t}\n140\t\t} else if !errors.Is(err, os.ErrNotExist) {\n141\t\t\treturn false, err\n142\t\t}\n143\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n144\t\t\treturn false, fmt.Errorf(\"create config directory: %w\", er